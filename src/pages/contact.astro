---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Contact us — Manati" description="Get in touch with Manati Alternate Student Funding — WhatsApp, phone or email.">
  <Header />

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Contact us</span>
      <h1>Get in touch</h1>
      <p>Whether you're a prospective student, an existing loan holder, or an institution interested in partnering, we'd love to hear from you.</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap contact-grid">
      <div>
        <h2 style="color:var(--navy);font-size:24px;margin-bottom:6px">Send us a message</h2>
        <p style="color:var(--muted);margin-bottom:18px">We'll get back to you as soon as we can.</p>
        <!-- Netlify Forms: submissions are captured automatically once deployed on Netlify -->
        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="form" action="/contact?sent=1">
          <input type="hidden" name="form-name" value="contact" />
          <p hidden><label>Don't fill this out: <input name="bot-field" /></label></p>
          <div class="row">
            <div>
              <label for="name">Name</label>
              <input id="name" name="name" type="text" required />
            </div>
            <div>
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required />
            </div>
          </div>
          <label for="reason">I'm contacting you as a…</label>
          <select id="reason" name="reason">
            <option>Prospective student</option>
            <option>Existing loan holder</option>
            <option>Educational institution</option>
            <option>Funder / partner</option>
            <option>Other</option>
          </select>
          <label for="message">Message</label>
          <textarea id="message" name="message" required></textarea>
          <div style="margin-top:18px"><button class="btn btn-primary" type="submit">Send message</button></div>
        </form>
      </div>

      <div>
        <div class="info-card">
          <h4>WhatsApp</h4>
          <p>Quickest way to reach us.</p>
          <a class="contact-list" href="https://wa.me/27646050554" style="color:var(--navy);font-weight:600">Chat on WhatsApp — 064 605 0554</a>
        </div>
        <div class="info-card">
          <h4>Applications</h4>
          <p>Questions about applying or an existing application.</p>
          <a href="mailto:Applications@manati.co.za" style="color:var(--navy);font-weight:600">Applications@manati.co.za</a>
        </div>
        <div class="info-card">
          <h4>Existing loan holders</h4>
          <p>For queries about your loan, contact your Account Manager or:</p>
          <a href="mailto:Collections@manati.co.za" style="color:var(--navy);font-weight:600">Collections@manati.co.za</a>
        </div>
        <div class="info-card">
          <h4>General &amp; office</h4>
          <p><a href="mailto:info@manati.co.za" style="color:var(--navy);font-weight:600">info@manati.co.za</a></p>
          <p><a href="tel:+27105945398" style="color:var(--navy);font-weight:600">+27 10 594 5398</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="block bg-soft">
    <div class="wrap" style="max-width:760px">
      <p style="color:var(--muted);font-size:14px">We strive to ensure our use of your personal information is lawful, reasonable and relevant to our business activities. Please read our <a href="/privacy/" style="color:var(--teal-d);font-weight:600">Privacy Notice</a> to understand how Manati keeps your information secure when providing financial and credit products and services.</p>
    </div>
  </section>

  <Footer />
</Base>
