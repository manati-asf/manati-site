---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const APPLY_URL = '#apply-form';
const LANDBOT_URL = 'https://chats.landbot.io/v3/H-710586-TZA6006OCE2GJZWZ/index.html';
---
<Base title="How to apply — Manati" description="Manati's entire application process is online. Apply for a study loan in minutes — no branches, no queues.">
  <Header />

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">How to apply</span>
      <h1>The whole application is online</h1>
      <p>You'll never have to take time off work to visit a branch or stand in a queue. Apply from anywhere, and improve your chances by applying with joint household income.</p>
      <div style="margin-top:24px"><a class="btn btn-primary" href={APPLY_URL}>Start your application →</a></div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Three simple steps</span>
        <h2>How it works</h2>
      </div>
      <div class="steps">
        <div class="step">
          <h4>Apply online</h4>
          <p>Complete the application from any device. Add your spouse or partner's income (with their consent) to apply with joint household income and strengthen your application.</p>
        </div>
        <div class="step">
          <h4>We assess</h4>
          <p>We review your academic results and the employability of your course to structure a reasonable loan on a case-by-case basis.</p>
        </div>
        <div class="step">
          <h4>Study &amp; succeed</h4>
          <p>Your instalments stay stable for the loan term, and we offer employment support to help you graduate and repay with confidence.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block bg-soft">
    <div class="wrap two-col">
      <div>
        <span class="eyebrow">Before you start</span>
        <h2>What you'll need</h2>
        <p>Having these ready makes the online application quick and smooth:</p>
        <ul style="list-style:none;padding:0">
          <li style="position:relative;padding-left:26px;margin:9px 0;color:var(--muted)"><span style="position:absolute;left:0;color:var(--teal-d);font-weight:800">✓</span> South African ID (and your partner's, if applying jointly)</li>
          <li style="position:relative;padding-left:26px;margin:9px 0;color:var(--muted)"><span style="position:absolute;left:0;color:var(--teal-d);font-weight:800">✓</span> Proof of income / latest payslips</li>
          <li style="position:relative;padding-left:26px;margin:9px 0;color:var(--muted)"><span style="position:absolute;left:0;color:var(--teal-d);font-weight:800">✓</span> Your institution and course details</li>
          <li style="position:relative;padding-left:26px;margin:9px 0;color:var(--muted)"><span style="position:absolute;left:0;color:var(--teal-d);font-weight:800">✓</span> Recent academic results</li>
        </ul>
      </div>
      <div class="info-card">
        <h4>Estimate your repayment first</h4>
        <p>Use the repayment calculator on our homepage to get an indicative monthly figure before you apply.</p>
        <div style="margin-top:14px"><a class="btn btn-dark" href="/#apply">Open the calculator</a></div>
      </div>
    </div>
  </section>

  <section class="block bg-soft" id="apply-form">
    <div class="wrap">
      <div class="sec-head" style="margin-bottom:28px">
        <span class="eyebrow">Apply now</span>
        <h2>Start your application</h2>
        <p>Complete it right here — it only takes a few minutes.</p>
      </div>
      <div style="max-width:760px;margin:0 auto">
        <iframe
          src={LANDBOT_URL}
          title="Manati online application"
          loading="lazy"
          style="width:100%;height:680px;border:1px solid var(--line);border-radius:16px;background:#fff;box-shadow:var(--shadow)"
        ></iframe>
        <p style="text-align:center;color:var(--muted);font-size:14px;margin-top:14px">
          Having trouble seeing the form? <a href={LANDBOT_URL} target="_blank" rel="noopener" style="color:var(--teal-d);font-weight:600">Open the application in a new tab →</a>
        </p>
      </div>
    </div>
  </section>

  <Footer />
</Base>
