---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// In-house application bot — Phase 2 (full applicant field set, v1).
// Documents are "collect-later" in v1 (we request them in a secure follow-up),
// so no file uploads here. Posts to /api/apply (Netlify proxy → TaskFlow).
// Runs on a separate /apply-bot route alongside the live Landbot page until cut-over.
// NOTE: option VALUES for some selection fields (gender, race, employment, bank,
// marital, relation, province) are best-guess / from the captured sample and
// should be confirmed against the Landbot flow + TaskFlow before go-live.
---
<Base title="Apply — Manati (new bot, preview)" description="Manati online application — new in-house bot (preview).">
  <Header />

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Apply · preview</span>
      <h1>Apply for funding</h1>
      <p>Our new in-house application — Wandi will guide you through a few questions. This preview replaces the embedded bot.</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width:540px">
      <div class="ab-device">
        <div class="ab-banner">Preview — submits to our TaskFlow proxy (<code>/api/apply</code>). Documents are requested after submission.</div>
        <div class="ab-head">
          <div class="ab-av">W</div>
          <div><div class="ab-logo">Wandi</div><div class="ab-sub">Manati application assistant</div></div>
        </div>
        <div class="ab-prog"><i id="ab-bar"></i></div>
        <div class="ab-chat" id="ab-chat"></div>
        <div class="ab-dock" id="ab-dock"></div>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style is:global>
  .ab-device{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);overflow:hidden;display:flex;flex-direction:column;height:660px;max-height:82vh;font-family:'Duru Sans',system-ui,sans-serif}
  .ab-banner{background:#fff7cf;color:#6b5e10;font-size:11.5px;text-align:center;padding:6px 10px;border-bottom:1px solid #f0e6a8}
  .ab-banner code{background:rgba(0,0,0,.05);padding:1px 4px;border-radius:4px}
  .ab-head{background:var(--navy);color:#fff;padding:14px 16px;display:flex;align-items:center;gap:11px}
  .ab-av{width:36px;height:36px;border-radius:50%;background:var(--gold);display:flex;align-items:center;justify-content:center;font-family:'Varela Round';font-weight:700;color:var(--navy)}
  .ab-logo{font-family:'Varela Round';font-weight:700;font-size:16px}
  .ab-sub{font-size:12px;color:#cfc9bd}
  .ab-prog{height:4px;background:#efece4}
  .ab-prog>i{display:block;height:100%;width:0;background:var(--gold);transition:width .4s}
  .ab-chat{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px}
  .ab-row{display:flex;gap:8px;align-items:flex-end}
  .ab-row.me{justify-content:flex-end}
  .ab-bub{max-width:82%;padding:11px 14px;border-radius:16px;font-size:14.5px;line-height:1.5}
  .ab-row.bot .ab-bub{background:#f3f1ea;color:#322f29;border-bottom-left-radius:5px}
  .ab-row.me .ab-bub{background:var(--navy);color:#fff;border-bottom-right-radius:5px}
  .ab-pic{width:28px;height:28px;border-radius:50%;background:var(--gold);flex:none;display:flex;align-items:center;justify-content:center;font-family:'Varela Round';font-weight:700;color:var(--navy);font-size:13px}
  .ab-dock{border-top:1px solid var(--line);padding:12px;background:#fff;min-height:62px}
  .ab-field{display:flex;gap:8px}
  .ab-dock input:not([type=checkbox]),.ab-dock select{flex:1;width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:12px;font:inherit;outline:none}
  .ab-dock input:not([type=checkbox]):focus{border-color:var(--teal-d);box-shadow:0 0 0 3px rgba(222,195,35,.25)}
  .ab-ip{position:relative;flex:1}
  .ab-ip .pfx{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--muted);font-weight:600}
  .ab-ip.has-pfx input{padding-left:30px}
  .ab-send{background:var(--gold);color:var(--navy);font-weight:700;border:0;border-radius:12px;padding:0 18px;font-family:'Varela Round';cursor:pointer}
  .ab-send:hover{background:var(--teal-d)}
  .ab-skip{background:transparent;color:var(--muted);border:0;font-family:'Varela Round';cursor:pointer;padding:0 10px;font-size:13px}
  .ab-skip:hover{color:var(--navy)}
  .ab-choices{display:flex;flex-direction:column;gap:8px;max-height:240px;overflow-y:auto}
  .ab-choice{background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:12px 14px;text-align:left;font-weight:600;color:var(--navy);cursor:pointer}
  .ab-choice:hover{border-color:var(--gold);background:var(--bg-soft)}
  .ab-consent{display:flex;gap:10px;align-items:flex-start;font-size:13px;color:var(--muted);margin-bottom:10px;line-height:1.5}
  .ab-consent input[type=checkbox]{flex:none;width:18px;height:18px;margin-top:2px;cursor:pointer}
  .ab-review{font-size:13px;background:var(--bg-soft);border:1px solid var(--line);border-radius:12px;padding:10px 14px;margin-bottom:10px;max-height:200px;overflow-y:auto}
  .ab-review div{display:flex;justify-content:space-between;gap:10px;padding:3px 0;border-bottom:1px dashed var(--line)}
  .ab-review div:last-child{border:0}
  .ab-review .k{color:var(--muted)}.ab-review .v{font-weight:600;text-align:right;color:var(--navy)}
  .ab-err{color:#c0392b;font-size:12px;margin-top:6px}
  .ab-hint{font-size:11.5px;color:#a59f90;text-align:center;margin-top:8px}
</style>

<script is:inline>
(function(){
  var chat=document.getElementById('ab-chat'), dock=document.getElementById('ab-dock'), bar=document.getElementById('ab-bar');
  var S={};

  var PROV=["Eastern Cape","Free State","Gauteng","KwaZulu-Natal","Limpopo","Mpumalanga","North West","Northern Cape","Western Cape"];
  var BANKS=["ABSA","Capitec","First National Bank","Nedbank","Standard Bank","TymeBank","African Bank","Other"];
  var EMP=["Permanent","Contract","Self-employed","Pensioner","Commission","Unemployed"];
  var yn=[{l:"Yes",v:"Yes"},{l:"No",v:"No"}];

  // Flow definition. t: intro|choice|text|email|tel|num|consent|info|review|done
  var FLOW=[
    {t:'intro', q:["Hi! I'm Wandi 👋 I'll guide you through your Manati funding application. It takes about 10 minutes, and you can apply with a sponsor's income to strengthen your application."], o:[{l:"Let's begin →",v:"start"}]},
    {k:'who', t:'choice', q:["First — who's completing this application?"], o:[{l:"I'm the student",v:"Student"},{l:"I'm a parent / sponsor",v:"Sponsor"}]},

    {sec:"About the student"},
    {k:'student_first', t:'text', q:["Student's first name?"], ph:"e.g. Thandi", v:nm},
    {k:'student_last', t:'text', q:["Student's surname?"], ph:"e.g. Mokoena", v:nm},
    {k:'student_id', t:'text', q:["Student's South African ID number?"], ph:"13 digits", opt:true, v:idv},
    {k:'student_phone', t:'tel', q:["A mobile number for the student?"], ph:"e.g. 082 123 4567", v:ph},
    {k:'student_email', t:'email', q:["Student's email address?"], ph:"you@example.com", opt:true, v:em},

    {sec:"Studies"},
    {k:'institution', t:'text', q:["Which university or college?"], ph:"e.g. University of the Western Cape", v:req},
    {k:'campus', t:'text', q:["Which campus? (if applicable)"], ph:"e.g. Bellville", opt:true},
    {k:'qualification', t:'text', q:["What qualification / course?"], ph:"e.g. BCom Accounting", v:req},
    {k:'year_of_study', t:'choice', q:["Year of study?"], opt:true, o:[{l:"1st year",v:"1"},{l:"2nd year",v:"2"},{l:"3rd year",v:"3"},{l:"4th year",v:"4"},{l:"Postgraduate",v:"Postgrad"}]},
    {k:'course_duration', t:'text', q:["How many years is the course in total?"], ph:"e.g. 3", opt:true},
    {k:'registered', t:'choice', q:["Are you already registered for the course?"], opt:true, o:yn},
    {k:'self_funded', t:'choice', q:["Will you fund the studies yourself, or is a parent/sponsor supporting the application?"], o:[{l:"I'm funding it myself",v:"Yes"},{l:"A parent/sponsor is supporting",v:"No"}]},

    // ---- Sponsor one identity (only if NOT self-funded) ----
    {sec:"Sponsor details", when:function(){return S.self_funded==='No';}},
    {k:'s1_first', t:'text', q:["Sponsor's first name?"], ph:"First name", when:function(){return S.self_funded==='No';}, v:nm},
    {k:'s1_last', t:'text', q:["Sponsor's surname?"], ph:"Surname", when:function(){return S.self_funded==='No';}, v:nm},
    {k:'s1_relation', t:'choice', q:["Relationship to the student?"], when:function(){return S.self_funded==='No';}, o:[{l:"Parent",v:"Parent"},{l:"Guardian",v:"Guardian"},{l:"Spouse / Partner",v:"Spouse/Partner"},{l:"Sibling",v:"Sibling"},{l:"Other family",v:"Other family"},{l:"Other",v:"Other"}]},
    {k:'s1_id', t:'text', q:["Sponsor's SA ID number?"], ph:"13 digits", opt:true, when:function(){return S.self_funded==='No';}, v:idv},
    {k:'s1_phone', t:'tel', q:["Sponsor's mobile number?"], ph:"e.g. 082 123 4567", when:function(){return S.self_funded==='No';}, v:ph},
    {k:'s1_email', t:'email', q:["Sponsor's email address?"], ph:"sponsor@example.com", opt:true, when:function(){return S.self_funded==='No';}, v:em},
    {k:'s1_province', t:'choice', q:["Sponsor's province?"], opt:true, when:function(){return S.self_funded==='No';}, o:PROV.map(function(p){return {l:p,v:p};})},
    {k:'s1_gender', t:'choice', q:["Sponsor's gender?"], opt:true, when:function(){return S.self_funded==='No';}, o:[{l:"Female",v:"f"},{l:"Male",v:"m"},{l:"Prefer not to say",v:""}]},
    {k:'s1_race', t:'choice', q:["Sponsor's population group? (for reporting)"], opt:true, when:function(){return S.self_funded==='No';}, o:["Black","Coloured","Indian","White","Other"].map(function(r){return {l:r,v:r};})},
    {k:'s1_marital', t:'choice', q:["Sponsor's marital status?"], opt:true, when:function(){return S.self_funded==='No';}, o:["Single","Married","Divorced","Widowed"].map(function(m){return {l:m,v:m};})},

    // ---- Income (sponsor one OR self) ----
    {sec:"Income & affordability"},
    {k:'s1_employment', t:'choice', q:[function(){return "What is "+who()+" employment status?";}], opt:true, o:EMP.map(function(e){return {l:e,v:e};})},
    {k:'s1_gross', t:'num', q:[function(){return "What is "+who()+" gross monthly income?";}], pfx:"R", v:req},
    {k:'s1_net', t:'num', q:["Net (take-home) monthly income?"], pfx:"R", opt:true},
    {k:'s1_bank', t:'choice', q:["Which bank?"], opt:true, o:BANKS.map(function(b){return {l:b,v:b};})},
    {k:'s1_addl_income', t:'choice', q:["Any additional income (e.g. rental, second job)?"], o:yn},
    {k:'s1_addl_value', t:'num', q:["How much additional income per month?"], pfx:"R", when:function(){return S.s1_addl_income==='Yes';}},
    {k:'s1_addl_source', t:'text', q:["Source of the additional income?"], ph:"e.g. rental property", when:function(){return S.s1_addl_income==='Yes';}},

    {sec:"Monthly expenses (optional — helps affordability)"},
    {k:'s1_bond_rent', t:'num', q:["Bond or rent per month?"], pfx:"R", opt:true},
    {k:'s1_vehicle', t:'num', q:["Vehicle finance instalment?"], pfx:"R", opt:true},
    {k:'s1_other_loans', t:'num', q:["Other loan / credit repayments?"], pfx:"R", opt:true},
    {k:'s1_insurance', t:'num', q:["Insurance / policies per month?"], pfx:"R", opt:true},
    {k:'s1_groceries', t:'num', q:["Groceries per month?"], pfx:"R", opt:true},
    {k:'s1_travel', t:'num', q:["Travel / transport per month?"], pfx:"R", opt:true},
    {k:'s1_phone_data', t:'num', q:["Phone & data per month?"], pfx:"R", opt:true},
    {k:'s1_other_exp', t:'num', q:["Any other monthly expenses?"], pfx:"R", opt:true},

    // ---- Joint application / sponsor two ----
    {sec:"Second sponsor"},
    {k:'sponsor_two_yes_no', t:'choice', q:["Would you like to add a second sponsor (joint application)? This can strengthen your application."], o:[{l:"No, just one sponsor",v:"No"},{l:"Yes, add a second sponsor",v:"Yes"}]},
    {k:'s2_first', t:'text', q:["Second sponsor's first name?"], ph:"First name", when:j, v:nm},
    {k:'s2_last', t:'text', q:["Second sponsor's surname?"], ph:"Surname", when:j, v:nm},
    {k:'s2_relation_to_s1', t:'choice', q:["Relationship to the first sponsor?"], when:j, o:[{l:"Spouse / Partner",v:"Spouse/Partner"},{l:"Parent",v:"Parent"},{l:"Sibling",v:"Sibling"},{l:"Other",v:"Other"}]},
    {k:'s2_id', t:'text', q:["Second sponsor's SA ID number?"], ph:"13 digits", opt:true, when:j, v:idv},
    {k:'s2_phone', t:'tel', q:["Second sponsor's mobile?"], ph:"e.g. 082 123 4567", when:j, v:ph},
    {k:'s2_email', t:'email', q:["Second sponsor's email?"], ph:"sponsor2@example.com", opt:true, when:j, v:em},
    {k:'s2_employment', t:'choice', q:["Second sponsor's employment status?"], opt:true, when:j, o:EMP.map(function(e){return {l:e,v:e};})},
    {k:'s2_gross', t:'num', q:["Second sponsor's gross monthly income?"], pfx:"R", when:j},
    {k:'s2_net', t:'num', q:["Second sponsor's net monthly income?"], pfx:"R", opt:true, when:j},
    {k:'s2_monthly_exp', t:'num', q:["Second sponsor's total monthly expenses?"], pfx:"R", opt:true, when:j},

    // ---- Loan ----
    {sec:"The funding you need"},
    {k:'loan_amount', t:'num', q:["Roughly how much funding do you need in total (per year)?"], pfx:"R", v:req},
    {k:'loan_tuition', t:'num', q:["Of that, how much is tuition?"], pfx:"R", opt:true},
    {k:'loan_accommodation', t:'num', q:["How much for accommodation?"], pfx:"R", opt:true},
    {k:'loan_equipment', t:'num', q:["How much for equipment (laptop, books)?"], pfx:"R", opt:true},
    {k:'loan_term', t:'num', q:["Over how many months would you like to repay?"], opt:true, ph:"e.g. 24"},

    {t:'info', q:["Almost done! We'll request your supporting documents — ID, proof of income, bank statements, and your academic results / acceptance letter — securely once your application is in."], o:[{l:"Got it →",v:"ok"}]},
    {k:'consent', t:'consent', q:["Last step — we need your consent to process your information and run the necessary credit and affordability checks."]},
    {t:'review', q:["Here's a summary — ready to submit?"]},
    {t:'done', q:[]}
  ];

  // validators
  function req(v){return v && v.trim().length>=2?null:"This one's required.";}
  function nm(v){return v && v.trim().length>=2?null:"Please enter at least 2 characters.";}
  function em(v){return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)?null:"That doesn't look like a valid email.";}
  function ph(v){return v.replace(/\D/g,'').length>=9?null:"Please enter a valid mobile number.";}
  function idv(v){return /^\d{13}$/.test(v.replace(/\s/g,''))?null:"A SA ID is 13 digits (or skip).";}
  function j(){return S.sponsor_two_yes_no==='Yes';}
  function who(){return S.self_funded==='Yes'?"your":"the sponsor's";}

  var i=-1;
  function addBot(t){var r=document.createElement('div');r.className='ab-row bot';r.innerHTML='<div class="ab-pic">W</div><div class="ab-bub"></div>';r.querySelector('.ab-bub').textContent=t;chat.appendChild(r);chat.scrollTop=chat.scrollHeight;}
  function addMe(t){var r=document.createElement('div');r.className='ab-row me';r.innerHTML='<div class="ab-bub"></div>';r.querySelector('.ab-bub').textContent=t;chat.appendChild(r);chat.scrollTop=chat.scrollHeight;}
  function prog(){bar.style.width=Math.round((i/(FLOW.length-1))*100)+'%';}
  function label(step,val){ if(step.o){var f=step.o.filter(function(o){return o.v===val;})[0]; if(f)return f.l;} return val; }

  function buildData(){
    var d={}, num=function(v){return (v===undefined||v===null||v==='')?null:Number(v);};
    var set=function(k,v){ if(v!==undefined && v!==null && v!=='') d[k]=v; };
    var self=S.self_funded==='Yes';
    d['x_student_or_sponsor']=S.who||'Student';
    d['x_crm.lead-x_consent_credit_check']='Yes';
    d['x_student-x_credit_check']='Yes';
    set('x_student-x_name',S.student_first); set('x_student-x_surname',S.student_last);
    set('x_student-x_id_number',S.student_id); set('x_student-phone',S.student_phone); set('x_student-email',S.student_email);
    set('x_crm.lead-x_educational_institution_id',S.institution); set('x_crm.lead-x_name_of_campus',S.campus);
    set('x_crm.lead-x_qualification',S.qualification); set('x_student_year_of_study',S.year_of_study);
    set('x_student_course_duration',S.course_duration); set('x_student_registered_yes_no',S.registered);
    set('x_crm.lead-x_self_funded',S.self_funded);
    if(self){
      set('x_sponsor.one-name',S.student_first); set('X_sponsor.one-surname',S.student_last);
      set('x_sponsor.one-id_number',S.student_id); set('x_sponsor.one-phone',S.student_phone); set('x_sponsor.one-email',S.student_email);
      set('x_crm.lead-x_relation_to_student','Self'); d['x_sponsor.one-x_credit_check']='Yes';
    } else {
      set('x_sponsor.one-name',S.s1_first); set('X_sponsor.one-surname',S.s1_last);
      set('x_sponsor.one-id_number',S.s1_id); set('x_sponsor.one-phone',S.s1_phone); set('x_sponsor.one-email',S.s1_email);
      set('x_crm.lead-x_relation_to_student',S.s1_relation);
      set('x_sponsor.one-gender',S.s1_gender); set('x_sponsor.one-x_race',S.s1_race);
      set('x_sponsor_one_marital_status',S.s1_marital); set('x_sponsor.one-x_state_id',S.s1_province);
      d['x_sponsor.one-x_credit_check']='Yes';
    }
    set('x_crm.lead-x_employment_status',S.s1_employment); set('x_sponsor_one_bank',S.s1_bank);
    set('x_crm.lead-x_gross_salary',num(S.s1_gross)); set('x_crm.lead-x_nett_salary',num(S.s1_net));
    set('x_crm.lead-x_sponsor_one_additional_income',S.s1_addl_income);
    set('x_crm.lead-x_sponsor_one_additional_income_value',num(S.s1_addl_value));
    set('x_crm.lead-x_sponsor_one_additional_income_source',S.s1_addl_source);
    set('x_sponsor_one_bond_or_rent',num(S.s1_bond_rent)); set('x_sponsor_one_vehicle_finance_instalment',num(S.s1_vehicle));
    set('x_sponsor_one_other_loans_instalment',num(S.s1_other_loans)); set('x_sponsor_one_travel_expense',num(S.s1_travel));
    set('x_sponsor_one_telepone_and_data',num(S.s1_phone_data)); set('x_sponsor_one_groceries',num(S.s1_groceries));
    set('x_sponsor_one_insurance_instalment',num(S.s1_insurance)); set('x_sponsor_one_other_expenses',num(S.s1_other_exp));
    set('x_sponsor_two_yes_no',S.sponsor_two_yes_no);
    if(S.sponsor_two_yes_no==='Yes'){
      set('x_sponsor.two-x_name',S.s2_first); set('x_sponsor.two-x_surname',S.s2_last);
      set('x_sponsor.two-x_id_number',S.s2_id); set('x_sponsor_two_relation_to_sponsor_one',S.s2_relation_to_s1);
      set('x_sponsor.two-phone',S.s2_phone); set('x_sponsor.two-email',S.s2_email);
      set('x_sponsor_two_employment_status',S.s2_employment);
      set('x_crm.lead-x_sponsor_two_gross_income',num(S.s2_gross)); set('x_crm.lead-x_sponsor_two_net_income',num(S.s2_net));
      set('x_sponsor_two_monthly_expenses',num(S.s2_monthly_exp));
      d['x_sponsor.two-x_credit_check']='Yes';
      if(S.s2_id) d['x_sponsor_two_id_number_available_yes_no']='Yes';
    }
    set('x_crm.lead-x_loan_amount',num(S.loan_amount)); set('x_loan_amount_tuition_fee',num(S.loan_tuition));
    set('x_loan_amount_equipment',num(S.loan_equipment)); set('x_loan_amount_accomodation',num(S.loan_accommodation));
    set('x_loan_term_manati',num(S.loan_term));
    d['x_documents_uploaded_yes_no']='No';
    return d;
  }

  async function submitApp(){
    dock.innerHTML='<div class="ab-hint">Submitting your application…</div>';
    try{
      var res=await fetch('/api/apply',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({data:buildData(),company:''})});
      var out=await res.json().catch(function(){return {};});
      if(res.ok && out.ok){
        addBot("🎉 Thank you! Your application has been submitted. A Manati consultant will be in touch shortly, and we'll request your supporting documents securely. ");
        dock.innerHTML='<div class="ab-hint">Submitted successfully.</div>';
      } else {
        addBot("Something went wrong submitting your application. Please try again, or email applications@manati.co.za.");
        dock.innerHTML='<div class="ab-field"><button class="ab-send" id="ab-retry" style="flex:1">Try again</button></div><div class="ab-err">'+((out&&out.error)||('Error '+res.status))+'</div>';
        document.getElementById('ab-retry').onclick=submitApp;
      }
    }catch(e){
      addBot("We couldn't reach our servers just now. Please try again in a moment.");
      dock.innerHTML='<div class="ab-field"><button class="ab-send" id="ab-retry" style="flex:1">Try again</button></div>';
      document.getElementById('ab-retry').onclick=submitApp;
    }
  }

  function render(step){
    dock.innerHTML=''; var t=step.t;
    if(t==='intro'||t==='choice'||t==='info'){
      var w=document.createElement('div'); w.className='ab-choices';
      step.o.forEach(function(o){var b=document.createElement('button');b.className='ab-choice';b.textContent=o.l;b.onclick=function(){if(step.k)S[step.k]=o.v;if(t==='choice')addMe(o.l);advance();};w.appendChild(b);});
      dock.appendChild(w);
      if(step.opt) addSkip();
      return;
    }
    if(t==='consent'){
      dock.innerHTML='<label class="ab-consent"><input type="checkbox" id="ab-cb"> I confirm my details are true, I\'m authorised to share them, and I consent to Manati processing my information and running credit and affordability checks, in line with the <a href="/privacy" target="_blank" style="color:var(--teal-d);font-weight:600">Privacy Notice</a>.</label><div class="ab-field"><button class="ab-send" id="ab-go" style="flex:1">I agree &amp; continue</button></div><div class="ab-err" id="ab-err"></div>';
      document.getElementById('ab-go').onclick=function(){if(!document.getElementById('ab-cb').checked){document.getElementById('ab-err').textContent="Please tick the box to continue.";return;}S.consent='Yes';addMe('I agree ✓');advance();};
      return;
    }
    if(t==='review'){
      var rows=[['Applicant',S.who],['Student',(S.student_first||'')+' '+(S.student_last||'')],['Institution',S.institution],['Course',S.qualification],['Self-funded',S.self_funded]];
      if(S.self_funded==='No') rows.push(['Sponsor',(S.s1_first||'')+' '+(S.s1_last||'')]);
      rows.push(['Gross income/mo',S.s1_gross?'R'+Number(S.s1_gross).toLocaleString('en-ZA'):'—']);
      rows.push(['Second sponsor',S.sponsor_two_yes_no||'No']);
      rows.push(['Funding needed',S.loan_amount?'R'+Number(S.loan_amount).toLocaleString('en-ZA'):'—']);
      dock.innerHTML='<div class="ab-review">'+rows.map(function(r){return '<div><span class="k">'+r[0]+'</span><span class="v">'+(r[1]||'—')+'</span></div>';}).join('')+'</div><div class="ab-field"><button class="ab-send" id="ab-go" style="flex:1">Submit application</button></div>';
      document.getElementById('ab-go').onclick=function(){addMe('Submit ✓');submitApp();};
      return;
    }
    if(t==='done'){return;}
    // text/email/tel/num
    var pfx=step.pfx?'<span class="pfx">'+step.pfx+'</span>':'';
    var itype=(t==='num')?'number':t;
    dock.innerHTML='<div class="ab-field"><div class="ab-ip '+(step.pfx?'has-pfx':'')+'">'+pfx+'<input id="ab-inp" type="'+itype+'" placeholder="'+(step.ph||'')+'"></div><button class="ab-send" id="ab-go">Send</button></div><div class="ab-err" id="ab-err"></div>';
    var inp=document.getElementById('ab-inp'); inp.focus();
    function go(){var v=inp.value; if(!v && step.opt){skip();return;} if(step.v){var e=step.v(v||''); if(e){document.getElementById('ab-err').textContent=e;return;}} S[step.k]=(v||'').trim(); addMe(step.pfx?(step.pfx+Number(v).toLocaleString('en-ZA')):v.trim()); advance();}
    document.getElementById('ab-go').onclick=go;
    inp.addEventListener('keydown',function(e){if(e.key==='Enter')go();});
    if(step.opt) addSkip();
  }
  function addSkip(){var s=document.createElement('div');s.style.textAlign='center';s.innerHTML='<button class="ab-skip" id="ab-skip">Skip</button>';dock.appendChild(s);document.getElementById('ab-skip').onclick=skip;}
  function skip(){advance();}

  function runStep(){
    prog(); var step=FLOW[i];
    var msgs=(step.q||[]).map(function(m){return typeof m==='function'?m():m;});
    dock.innerHTML=''; var k=0;
    (function next(){ if(k>=msgs.length){render(step);return;} addBot(msgs[k]); k++; setTimeout(next,300); })();
  }
  function advance(){
    do { i++; } while(i<FLOW.length && (FLOW[i].sec || (FLOW[i].when && !FLOW[i].when())));
    if(i>=FLOW.length) return;
    // announce a new section heading as a bot line
    runStep();
  }
  advance();
})();
</script>
