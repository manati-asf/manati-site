---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import INSTITUTIONS from '../data/institutions.json';
const TS_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
// In-house application bot — Phase 2 (v3): pop-out widget, mobile-first, grouped cards.
// - Pop-out overlay (floating launcher + modal). Full-screen on mobile, card on desktop.
// - Flow mirrors the Landbot but groups many questions into a few "form" cards to cut screens.
// - Sponsor details collected in full first, then student details.
// - Tuition only (no accommodation / equipment). No Skip buttons anywhere.
// - Documents deferred (requested after submission). Both consents kept: WhatsApp (start) + credit/POPIA (end).
// Posts to /api/apply (Netlify proxy → TaskFlow).
// NOTE (confirm before go-live): option VALUES and payload keys for NEW fields
// (existing-customer, ID type, demographics) and institution → ei_id mapping are best-guess;
// test mode (TASKFLOW_TEST_MODE=1) echoes the exact payload so these can be verified.
---
<Base title="Apply for funding — Manati" description="Apply for a Manati study loan online. Nati, our application assistant, will guide you through a few quick questions — it takes about 5 minutes.">
  <Header />
  {TS_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <div id="ab-ts" data-sitekey={TS_SITE_KEY} style="display:none"></div>

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Apply now</span>
      <h1>Apply for funding</h1>
      <p>Our new in-house application — Nati will guide you through a few quick questions. It takes about 5 minutes.</p>
      <p style="margin-top:18px"><button id="ab-open-hero" class="btn btn-primary" type="button">Start your application →</button></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width:720px">
      <p style="color:var(--muted)">Prefer to apply now? Tap the button above or the <strong>Apply with Nati</strong> button in the corner. You can apply on your own income, or add a sponsor's income to strengthen your application.</p>
    </div>
  </section>

  <!-- Floating launcher -->
  <button id="ab-launch" class="ab-launch" type="button" aria-label="Open the Manati application assistant">
    <span class="ab-launch-dot">N</span> Apply with Nati
  </button>

  <!-- Pop-out overlay -->
  <div id="ab-overlay" class="ab-overlay" hidden>
    <div class="ab-device" role="dialog" aria-label="Manati application assistant" aria-modal="true">
      <div class="ab-head">
        <div class="ab-av">N</div>
        <div class="ab-head-t"><div class="ab-logo">Nati</div><div class="ab-sub">Manati application assistant</div></div>
        <button id="ab-close" class="ab-close" type="button" aria-label="Close">&times;</button>
      </div>
      <div class="ab-prog"><i id="ab-bar"></i></div>
      <div class="ab-chat" id="ab-chat"></div>
      <div class="ab-dock" id="ab-dock"></div>
      <div class="ab-foot">Your information is secure. Documents are requested after submission.</div>
    </div>
  </div>

  <datalist id="ab-inst-list">
    {INSTITUTIONS.map((i) => (<option value={i.name}></option>))}
  </datalist>

  <Footer />
</Base>

<style is:global>
  /* Launcher */
  .ab-launch{position:fixed;right:18px;bottom:18px;z-index:9998;display:inline-flex;align-items:center;gap:9px;background:var(--gold);color:var(--navy);border:0;border-radius:999px;padding:12px 18px;font-family:'Varela Round',system-ui,sans-serif;font-weight:700;font-size:15px;box-shadow:0 8px 24px rgba(0,0,0,.18);cursor:pointer}
  .ab-launch:hover{filter:brightness(.97)}
  .ab-launch-dot{width:24px;height:24px;border-radius:50%;background:var(--navy);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:13px}

  /* Overlay + device */
  .ab-overlay{position:fixed;inset:0;z-index:9999;background:rgba(20,18,16,.55);display:flex;align-items:center;justify-content:center;padding:24px}
  .ab-overlay[hidden]{display:none}
  .ab-device{background:#fff;border-radius:20px;box-shadow:0 24px 60px rgba(0,0,0,.3);overflow:hidden;display:flex;flex-direction:column;width:440px;max-width:100%;height:660px;max-height:92vh;font-family:'Duru Sans',system-ui,sans-serif}
  .ab-head{background:var(--navy);color:#fff;padding:14px 16px;display:flex;align-items:center;gap:11px}
  .ab-av{width:36px;height:36px;border-radius:50%;background:var(--gold);display:flex;align-items:center;justify-content:center;font-family:'Varela Round';font-weight:700;color:var(--navy)}
  .ab-head-t{flex:1;min-width:0}
  .ab-logo{font-family:'Varela Round';font-weight:700;font-size:16px}
  .ab-sub{font-size:12px;color:#cfc9bd}
  .ab-close{background:transparent;border:0;color:#fff;font-size:26px;line-height:1;cursor:pointer;padding:0 4px;opacity:.85}
  .ab-close:hover{opacity:1}
  .ab-prog{height:4px;background:#efece4}
  .ab-prog>i{display:block;height:100%;width:0;background:var(--gold);transition:width .4s}
  .ab-chat{flex:1;min-height:0;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px}
  .ab-row{display:flex;gap:8px;align-items:flex-end}
  .ab-row.me{justify-content:flex-end}
  .ab-bub{max-width:85%;padding:11px 14px;border-radius:16px;font-size:14.5px;line-height:1.5;white-space:pre-line}
  .ab-row.bot .ab-bub{background:#f3f1ea;color:#322f29;border-bottom-left-radius:5px}
  .ab-row.me .ab-bub{background:var(--navy);color:#fff;border-bottom-right-radius:5px}
  .ab-pic{width:28px;height:28px;border-radius:50%;background:var(--gold);flex:none;display:flex;align-items:center;justify-content:center;font-family:'Varela Round';font-weight:700;color:var(--navy);font-size:13px}
  .ab-dock{border-top:1px solid var(--line);padding:12px;background:#fff;max-height:62%;overflow-y:auto}
  .ab-foot{font-size:10.5px;color:#a59f90;text-align:center;padding:5px 10px;background:#faf8f3;border-top:1px solid var(--line)}
  .ab-field{display:flex;gap:8px}
  .ab-dock input:not([type=checkbox]),.ab-dock select{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:12px;font:inherit;outline:none;background:#fff}
  .ab-dock input:focus,.ab-dock select:focus{border-color:var(--teal-d);box-shadow:0 0 0 3px rgba(222,195,35,.25)}
  .ab-dock input.bad,.ab-dock select.bad{border-color:#c0392b;box-shadow:0 0 0 3px rgba(192,57,43,.12)}
  .ab-ip{position:relative;flex:1}
  .ab-ip .pfx{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--muted);font-weight:600}
  .ab-ip.has-pfx input{padding-left:30px}
  .ab-send{background:var(--gold);color:var(--navy);font-weight:700;border:0;border-radius:12px;padding:0 18px;font-family:'Varela Round';cursor:pointer;min-height:46px}
  .ab-send:hover{filter:brightness(.97)}
  .ab-choices{display:flex;flex-direction:column;gap:8px}
  .ab-choice{background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:13px 14px;text-align:left;font-weight:600;color:var(--navy);cursor:pointer;font-family:inherit;font-size:14.5px}
  .ab-choice:hover{border-color:var(--gold);background:var(--bg-soft)}
  /* Grouped form card */
  .ab-form-t{font-family:'Varela Round';font-weight:700;color:var(--navy);font-size:15px;margin-bottom:10px}
  .ab-fl{display:block;font-size:12.5px;color:var(--muted);font-weight:600;margin:10px 0 4px}
  .ab-fl:first-of-type{margin-top:0}
  .ab-fip{position:relative}
  .ab-fip.has input{padding-left:30px}
  .ab-fip .ab-pfx{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--muted);font-weight:600}
  .ab-consent{display:flex;gap:10px;align-items:flex-start;font-size:13px;color:var(--muted);margin-bottom:10px;line-height:1.5}
  .ab-consent input[type=checkbox]{flex:none;width:18px;height:18px;margin-top:2px;cursor:pointer}
  .ab-review{font-size:13px;background:var(--bg-soft);border:1px solid var(--line);border-radius:12px;padding:10px 14px;margin-bottom:10px}
  .ab-review div{display:flex;justify-content:space-between;gap:10px;padding:3px 0;border-bottom:1px dashed var(--line)}
  .ab-review div:last-child{border:0}
  .ab-review .k{color:var(--muted)}.ab-review .v{font-weight:600;text-align:right;color:var(--navy)}
  .ab-notice-p{font-size:13.5px;line-height:1.5;color:#322f29;margin:0 0 10px}
  .ab-notice-p a{color:var(--teal-d);font-weight:600}
  .ab-ghost{background:transparent;color:var(--navy);border:1.5px solid var(--line);border-radius:12px;padding:0 16px;font-family:'Varela Round';cursor:pointer;min-height:46px}
  .ab-ghost:hover{border-color:var(--gold)}
  .ab-tsbox{margin:12px 0 4px;min-height:65px}
  .ab-err{color:#c0392b;font-size:12px;margin-top:8px}
  .ab-hint{font-size:11.5px;color:#a59f90;text-align:center;margin-top:8px}
  .ab-linkbtn{background:none;border:0;padding:0;color:var(--teal-d);font:inherit;font-weight:600;text-decoration:underline;cursor:pointer}
  .ab-dock input.ab-locked{background:#f6f4ee;color:#5f5a4f}

  @media (max-width:600px){
    .ab-overlay{padding:0}
    .ab-device{width:100%;height:100%;max-height:100%;border-radius:0}
    .ab-launch{right:12px;bottom:12px;padding:11px 16px;font-size:14px}
  }
</style>

<script is:inline>
(function(){
  var overlay=document.getElementById('ab-overlay');
  var chat=document.getElementById('ab-chat'), dock=document.getElementById('ab-dock'), bar=document.getElementById('ab-bar');
  var S={}, started=false, finished=false;

  var PROV=["Eastern Cape","Free State","Gauteng","KwaZulu-Natal","Limpopo","Mpumalanga","North West","Northern Cape","Western Cape","Outside South Africa"];
  var BANKS=["ABSA","Capitec","First National Bank (FNB)","Nedbank","Standard Bank","Other"];
  var EMP=["Permanent","Government Employee","Fixed-term","Temporary","Independent Consultant","Pensioner","Self-employed","Unemployed"];
  var ETHNIC=["Black","Coloured","Indian","White","Other","Prefer not to say"];
  var DUR=["6 months","12 months","18 months","24 months","30 months","36 months","48 months"];
  var ID_TYPE=[{l:"South African ID",v:"id_number"},{l:"Passport",v:"passport"},{l:"Other – SA residency permit / visa",v:"residency"}];
  var GENDER=[{l:"Female",v:"f"},{l:"Male",v:"m"}];
  function gmap(v){return (v==='f'||v==='m')?v:undefined;}
  var RELS=["Parent","Guardian","Spouse / Partner","Sibling","Other family","Other"];
  var RELS2=["Spouse / Partner","Parent","Sibling","Other"];
  var ADDL_SRC=["Commission","Incentive","Rental","Overtime","Pension","Child maintenance","Investment interest","Other"];
  var yn=[{l:"Yes",v:"Yes"},{l:"No",v:"No"}];

  var CONSENT_VERSION="2026-11-10";
  var WA_NOTICE_HTML='<div class="ab-form-t">Before we begin</div><p class="ab-notice-p">Manati Alternate Student Funding (NCRCP8052) will use the information you give us to assess your study loan application. We only share it with the parties we need to process your application, as set out in our <a href="/privacy/" target="_blank">Privacy Notice</a>. We will also ask for your population group, which we use only for reporting to the National Credit Regulator, and your gender, which we use with your ID or passport number to verify your identity and obtain your credit report.</p><p class="ab-notice-p"><strong>How may we contact you about your application?</strong><br>We would like to send you updates and document requests on WhatsApp. You can reply STOP at any time to stop WhatsApp messages.</p>';

  var SPONSOR_INTRO="Who is a sponsor?\n\nYour sponsor is the person who takes out the loan to fund the studies. The loan is in their name and they are responsible for the monthly instalments, so they must be employed or earn a reliable income. A sponsor is usually a parent, guardian, spouse or family member.\n\nBecause the loan is assessed on the sponsor's income and credit profile, Manati will contact them to get their consent and supporting documents before the application can be finalised.";

  function isStudent(){return S.who==='Student';}
  function selfFunded(){return S.who==='Student' && S.employed_studying==='Yes';}
  function notSelf(){return !selfFunded();}
  function j(){return notSelf() && S.sponsor_two_yes_no==='Yes';}
  // Verification code step: needed once per applicant (re-asked if "who" changes).
  function needOtp(){return !(S.vtok && S.vwho===S.who);}
  function who(){return selfFunded()?"your":"the sponsor's";}

  // validators
  function req(v){return v && v.trim().length>=2?null:"This one's required.";}
  function nm(v){return v && v.trim().length>=2?null:"Please enter at least 2 characters.";}
  function em(v){return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)?null:"That doesn't look like a valid email.";}
  function ph(v){return v.replace(/\D/g,'').length>=9?null:"Please enter a valid mobile number.";}
  function reqnum(v){return (v!==''&&!isNaN(Number(v))&&Number(v)>=0)?null:"Please enter an amount.";}
  function idsoft(v){var s=v.replace(/\s/g,''); if(!s) return null; return (/^\d{13}$/.test(s)||s.length>=6)?null:"Enter a 13-digit SA ID or a valid passport number.";}
  // Population group "Prefer not to say" is a valid choice but is not sent to TaskFlow as a race value.
  function race(v){return (v && v!=='Prefer not to say')?v:undefined;}

  // Flow. Types: intro|info|choice|text|consent|form|review|done
  var FLOW=[
    {t:'intro', q:["Hi! I'm Nati 👋 I'll guide you through your Manati funding application. It takes about 5 minutes."], o:[{l:"Let's begin →",v:"start"}]},
    {k:'wa_channel', t:'wachoice', html:WA_NOTICE_HTML, o:[{l:"Yes, you may contact me on WhatsApp",v:"WhatsApp"},{l:"No, please use SMS or email",v:"SMS/email"}]},
    {k:'existing_customer', t:'choice', q:["Are you an existing Manati customer (do you currently have a Manati loan from a previous year of study)?"], o:[{l:"No, this is my first Manati application",v:"No"},{l:"Yes, I am an existing Manati customer",v:"Yes"}]},
    {k:'institution', t:'text', q:["Which educational institution will the student study at? Start typing and pick from the list."], ph:"Start typing your institution…", list:'ab-inst-list', v:req},
    {k:'who', t:'choice', q:["Are you the student, or a sponsor supporting the student? (A sponsor is a parent, guardian, spouse or family member applying with their income.)"], o:[{l:"I'm the student",v:"Student"},{l:"I'm a parent / sponsor",v:"Sponsor"}]},
    {k:'employed_studying', t:'choice', when:isStudent, q:["Are you currently employed, and will you remain employed while studying?"], o:yn},
    {k:'otp', t:'otp', when:needOtp, q:[function(){return "One quick security step: we'll SMS a 6-digit code to "+(S.who==='Sponsor'?"your (the sponsor's)":"your")+" mobile number.\n\nThis protects you. It makes sure only you can apply using your number, so no one else can apply in your name.";}]},

    // Funding (tuition only) + course duration
    {t:'form', title:"Funding needed", q:["Great — let's get the funding details."], fields:[
      {k:'tuition', label:"Tuition fee to be funded (per year)", type:'num', pfx:"R", v:reqnum},
      {k:'course_duration', label:"Total course duration", type:'select', options:DUR}
    ], done:"✓ Funding details captured"},

    // ---- Sponsor path: explainer, full sponsor details, then sponsor income, then optional 2nd sponsor ----
    {t:'info', when:notSelf, q:[SPONSOR_INTRO], o:[{l:"Got it →",v:"ok"}]},
    {t:'form', when:notSelf, title:"Sponsor details", q:["Now the sponsor's details."], fields:[
      {k:'s1_first', label:"First name", type:'text', v:nm},
      {k:'s1_last', label:"Surname", type:'text', v:nm},
      {k:'s1_relation', label:"Relationship to the student", type:'select', options:RELS},
      {k:'s1_id_type', label:"Identification type", type:'select', options:ID_TYPE},
      {k:'s1_id', label:"ID / passport number", type:'text', v:idsoft},
      {k:'s1_phone', label:"Mobile number", type:'tel', v:ph},
      {k:'s1_phone2', label:"Confirm mobile number", type:'tel', v:ph},
      {k:'s1_email', label:"Email address", type:'email', v:em},
      {k:'s1_email2', label:"Confirm email address", type:'email', v:em},
      {k:'s1_gender', label:"Gender", type:'select', options:GENDER},
      {k:'s1_ethnicity', label:"Population group", type:'select', options:ETHNIC},
      {k:'s1_province', label:"Province of residence", type:'select', options:PROV}
    ], match:[['s1_phone','s1_phone2',"The mobile numbers don't match."],['s1_email','s1_email2',"The email addresses don't match."]], done:"✓ Sponsor details captured"},
    {t:'form', when:notSelf, title:"Sponsor income & banking", fields:[
      {k:'emp_status', label:"Employment status", type:'select', options:EMP},
      {k:'gross', label:"Gross monthly income", type:'num', pfx:"R", v:reqnum},
      {k:'net', label:"Net (take-home) monthly income", type:'num', pfx:"R", v:reqnum},
      {k:'addl_value', label:"Additional income per month (optional)", type:'num', pfx:"R", opt:true},
      {k:'addl_source', label:"Source of additional income (if any)", type:'select', opt:true, options:ADDL_SRC},
      {k:'bank', label:"Bank", type:'select', options:BANKS}
    ], done:"✓ Income captured"},
    {k:'sponsor_two_yes_no', t:'choice', when:notSelf, q:["Is there a second income in the household, or another sponsor whose income we can consider?"], o:[{l:"No, only one income",v:"No"},{l:"Yes, add a second sponsor",v:"Yes"}]},
    {t:'form', when:j, title:"Second sponsor", fields:[
      {k:'s2_first', label:"First name", type:'text', v:nm},
      {k:'s2_last', label:"Surname", type:'text', v:nm},
      {k:'s2_relation_to_s1', label:"Relationship to the first sponsor", type:'select', options:RELS2},
      {k:'s2_id', label:"SA ID number (optional)", type:'text', opt:true, v:idsoft},
      {k:'s2_phone', label:"Mobile number", type:'tel', v:ph},
      {k:'s2_email', label:"Email (optional)", type:'email', opt:true, v:em},
      {k:'s2_employment', label:"Employment status (optional)", type:'select', opt:true, options:EMP},
      {k:'s2_gross', label:"Gross monthly income", type:'num', pfx:"R", v:reqnum},
      {k:'s2_net', label:"Net monthly income (optional)", type:'num', pfx:"R", opt:true}
    ], done:"✓ Second sponsor captured"},

    // ---- Student details (always) ----
    {t:'form', title:"Student details", q:["And now the student's details."], fields:[
      {k:'student_first', label:"First name", type:'text', v:nm},
      {k:'student_last', label:"Surname", type:'text', v:nm},
      {k:'student_id_type', label:"Identification type", type:'select', options:ID_TYPE},
      {k:'student_id', label:"ID / passport number", type:'text', v:idsoft},
      {k:'student_phone', label:"Mobile number", type:'tel', v:ph},
      {k:'student_phone2', label:"Confirm mobile number", type:'tel', v:ph},
      {k:'student_email', label:"Email address", type:'email', v:em},
      {k:'student_email2', label:"Confirm email address", type:'email', v:em},
      {k:'student_gender', label:function(){return selfFunded()?"Gender":"Gender (optional)";}, type:'select', opt:function(){return !selfFunded();}, options:GENDER},
      {k:'student_ethnicity', label:function(){return selfFunded()?"Population group":"Population group (optional)";}, type:'select', opt:function(){return !selfFunded();}, options:ETHNIC},
      {k:'student_province', label:"Province of residence", type:'select', options:PROV}
    ], match:[['student_phone','student_phone2',"The mobile numbers don't match."],['student_email','student_email2',"The email addresses don't match."]], done:"✓ Student details captured"},

    // ---- Self-funded student: the student is the earner ----
    {t:'form', when:selfFunded, title:"Your income & banking", fields:[
      {k:'emp_status', label:"Employment status", type:'select', options:EMP},
      {k:'gross', label:"Gross monthly income", type:'num', pfx:"R", v:reqnum},
      {k:'net', label:"Net (take-home) monthly income", type:'num', pfx:"R", v:reqnum},
      {k:'addl_value', label:"Additional income per month (optional)", type:'num', pfx:"R", opt:true},
      {k:'addl_source', label:"Source of additional income (if any)", type:'select', opt:true, options:ADDL_SRC},
      {k:'bank', label:"Bank", type:'select', options:BANKS}
    ], done:"✓ Income captured"},

    {t:'info', q:[function(){return "Almost done! We'll request "+(notSelf()?"the sponsor's and student's":"your")+" supporting documents — ID, proof of income, bank statements, and the acceptance letter / fee statement — securely once your application is in.";}], o:[{l:"Got it →",v:"ok"}]},
    {t:'review', q:["Please review your details. You can make changes before you submit."]},
    {k:'consent', t:'consent', q:["Last step — your declaration and consent."]},
    {t:'done', q:[]}
  ];

  var i=-1;
  var EDIT_FROM=0; for(var _z=0;_z<FLOW.length;_z++){ if(FLOW[_z].k==='institution'){ EDIT_FROM=_z; break; } }
  function addBot(t){var r=document.createElement('div');r.className='ab-row bot';r.innerHTML='<div class="ab-pic">N</div><div class="ab-bub"></div>';r.querySelector('.ab-bub').textContent=t;chat.appendChild(r);chat.scrollTop=chat.scrollHeight;}
  function addMe(t){var r=document.createElement('div');r.className='ab-row me';r.innerHTML='<div class="ab-bub"></div>';r.querySelector('.ab-bub').textContent=t;chat.appendChild(r);chat.scrollTop=chat.scrollHeight;}
  function prog(){bar.style.width=Math.round((i/(FLOW.length-1))*100)+'%';}
  function esc(s){return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');}
  function optsHTML(options){return options.map(function(o){var l=(o&&o.l!==undefined)?o.l:o; var v=(o&&o.v!==undefined)?o.v:o; return '<option value="'+esc(v)+'">'+esc(l)+'</option>';}).join('');}

  function buildData(){
    var d={}, num=function(v){return (v===undefined||v===null||v==='')?null:Number(v);};
    var set=function(k,v){ if(v!==undefined && v!==null && v!=='') d[k]=v; };
    var self=selfFunded();

    d['x_student_or_sponsor']=S.who||'Student';
    // Loan-holder consent: "Yes" only when the loan holder completed the form themselves, else "Outstanding".
    // Loan holder = the student when self-funded, otherwise the sponsor.
    var loanHolderPresent = self || (S.who==='Sponsor');
    d['x_crm.lead-x_consent_credit_check'] = loanHolderPresent ? 'Yes' : 'Outstanding';
    // WhatsApp is an active choice (Screen 1), recorded as the applicant's chosen channel.
    set('x_whatsapp_consent', S.wa_channel==='WhatsApp' ? 'Yes' : 'No');
    set('x_contact_channel', S.wa_channel==='WhatsApp' ? 'WhatsApp' : 'SMS/email');
    // Record the declaration/consent itself.
    set('x_consent_given_by', S.who);
    set('x_consent_timestamp', S.consent_ts);
    set('x_consent_version', CONSENT_VERSION);
    var consentNotes=[]; // flag parties who were NOT present to consent (never assume consent)
    set('x_crm.lead-x_current_student_loan', S.existing_customer==='Yes' ? 'Yes' : 'No');

    // Student identity + demographics
    set('x_student-x_name',S.student_first); set('x_student-x_surname',S.student_last);
    set('x_student-x_id_number',S.student_id); set('x_student-phone',S.student_phone); set('x_student-email',S.student_email);
    set('x_student-identification_type', S.student_id_type);
    set('x_student-gender', gmap(S.student_gender));
    set('x_student-x_race', race(S.student_ethnicity));
    set('x_student-x_state_id', S.student_province);

    // Studies
    set('x_crm.lead-x_educational_institution_id',S.institution); // confirm key (Landbot writes ei_id)
    set('x_student_course_duration',S.course_duration);
    set('x_crm.lead-x_self_funded', self ? 'Yes' : 'No');

    // Primary income earner → sponsor.one slot
    if(self){
      set('x_sponsor.one-name',S.student_first); set('X_sponsor.one-surname',S.student_last);
      set('x_sponsor.one-id_number',S.student_id); set('x_sponsor.one-phone',S.student_phone); set('x_sponsor.one-email',S.student_email);
      set('x_crm.lead-x_relation_to_student','Self');
      // Self-funded: the student is present and is the income earner → they consent for themselves
      d['x_student-x_credit_check']='Yes'; d['x_sponsor.one-x_credit_check']='Yes';
      set('x_sponsor.one-gender',gmap(S.student_gender)); set('x_sponsor.one-x_race',race(S.student_ethnicity));
      set('x_sponsor.one-x_state_id',S.student_province);
    } else {
      set('x_sponsor.one-name',S.s1_first); set('X_sponsor.one-surname',S.s1_last);
      set('x_sponsor.one-id_number',S.s1_id); set('x_sponsor.one-phone',S.s1_phone); set('x_sponsor.one-email',S.s1_email);
      set('x_crm.lead-x_relation_to_student',S.s1_relation);
      set('x_sponsor.one-gender',gmap(S.s1_gender)); set('x_sponsor.one-x_race',race(S.s1_ethnicity));
      set('x_sponsor.one-x_state_id',S.s1_province);
      if(S.who==='Sponsor'){
        // The sponsor (loan holder) completed the form and is present → they consent; the student was not present
        d['x_sponsor.one-x_credit_check']='Yes'; d['x_student-x_credit_check']='Outstanding';
        consentNotes.push('Sponsor completed the application; the student was not present to give consent.');
      } else {
        // The student applied on the sponsor's behalf → sponsor (loan holder) was NOT present; do not assume their consent
        d['x_student-x_credit_check']='Yes'; d['x_sponsor.one-x_credit_check']='Outstanding';
        consentNotes.push("Student applied on the sponsor's behalf. Obtain the sponsor's own consent directly before running any sponsor credit check.");
      }
    }

    set('x_crm.lead-x_employment_status',S.emp_status); set('x_sponsor_one_bank',S.bank);
    set('x_crm.lead-x_gross_salary',num(S.gross)); set('x_crm.lead-x_nett_salary',num(S.net));
    if(S.addl_value && Number(S.addl_value)>0){
      set('x_crm.lead-x_sponsor_one_additional_income','Yes');
      set('x_crm.lead-x_sponsor_one_additional_income_value',num(S.addl_value));
      set('x_crm.lead-x_sponsor_one_additional_income_source',S.addl_source);
    }

    set('x_sponsor_two_yes_no', notSelf() ? (S.sponsor_two_yes_no||'No') : 'No');
    if(j()){
      set('x_sponsor.two-x_name',S.s2_first); set('x_sponsor.two-x_surname',S.s2_last);
      set('x_sponsor.two-x_id_number',S.s2_id); set('x_sponsor_two_relation_to_sponsor_one',S.s2_relation_to_s1);
      set('x_sponsor.two-phone',S.s2_phone); set('x_sponsor.two-email',S.s2_email);
      set('x_sponsor_two_employment_status',S.s2_employment);
      set('x_crm.lead-x_sponsor_two_gross_income',num(S.s2_gross)); set('x_crm.lead-x_sponsor_two_net_income',num(S.s2_net));
      // Second sponsor is not present during the application → do not assume their consent
      d['x_sponsor.two-x_credit_check']='Outstanding';
      consentNotes.push("Obtain the second sponsor's own consent directly before running any credit check.");
      if(S.s2_id) d['x_sponsor_two_id_number_available_yes_no']='Yes';
    }

    // Tuition only
    set('x_crm.lead-x_loan_amount',num(S.tuition)); set('x_loan_amount_tuition_fee',num(S.tuition));
    d['x_documents_uploaded_yes_no']='No';
    if(consentNotes.length) set('x_special_instruction', consentNotes.join(' '));
    return d;
  }

  var _tsEl=document.getElementById('ab-ts');
  var _tsKey=_tsEl?(_tsEl.getAttribute('data-sitekey')||''):'';
  var _tsToken='', _tsWidgetId=null;

  // Render a VISIBLE Turnstile widget into the review step so the challenge can
  // appear (an invisible widget in a hidden container fails on mobile).
  function mountTurnstile(){
    if(!_tsKey) return;
    if(!document.getElementById('ab-ts-box')) return;
    if(!window.turnstile){ setTimeout(mountTurnstile,300); return; }
    _tsToken='';
    try{
      if(_tsWidgetId!==null){ try{ window.turnstile.remove(_tsWidgetId); }catch(e){} _tsWidgetId=null; }
      _tsWidgetId=window.turnstile.render('#ab-ts-box',{
        sitekey:_tsKey,
        callback:function(tok){ _tsToken=tok||''; var e=document.getElementById('ab-err'); if(e) e.textContent=''; },
        'expired-callback':function(){ _tsToken=''; },
        'error-callback':function(){ _tsToken=''; }
      });
    }catch(e){}
  }

  async function submitApp(){
    if(_tsKey && !_tsToken){ var ee=document.getElementById('ab-err'); if(ee) ee.textContent="Please complete the verification check above."; return; }
    addMe('Submit ✓');
    dock.innerHTML='<div class="ab-hint">Submitting your application…</div>';
    try{
      var res=await fetch('/api/apply',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({data:buildData(),company:'',turnstileToken:_tsToken,verifiedToken:S.vtok||''})});
      var out=await res.json().catch(function(){return {};});
      if(res.ok && out.ok){
        finished=true;
        addBot("🎉 Thank you! Your application has been submitted.\n\nWhat happens next: a Manati consultant will contact you shortly to request your supporting documents securely. The sooner we receive them, the sooner we can finalise your application, so please have them ready.");
        if(notSelf()){
          addBot("A quick heads-up: please let your sponsor know that Manati will contact them directly for their consent and supporting documents. We can only finalise the application once we have both, so letting them know now helps avoid delays.");
        }
        dock.innerHTML='<div class="ab-field"><button class="ab-send" id="ab-doneb" style="flex:1">Close</button></div>';
        document.getElementById('ab-doneb').onclick=closeWidget;
      } else {
        addBot("Something went wrong submitting your application. Please try again, or email applications@manati.co.za.");
        _tsToken='';
        render(FLOW[i]); // re-render the review with a fresh verification check
        var e2=document.getElementById('ab-err'); if(e2) e2.textContent=(out&&out.error)||('Error '+res.status);
      }
    }catch(e){
      addBot("We couldn't reach our servers just now. Please try again in a moment.");
      _tsToken='';
      render(FLOW[i]);
    }
  }

  // ---- Verification code step (SMS first, email backup) ----
  function localPhone(v){var d=String(v||'').replace(/\D/g,''); if(d.length===11&&d.indexOf('27')===0) d='0'+d.slice(2); return d;}
  async function postJSON(url,obj){
    try{ var r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(obj)}); var o=await r.json().catch(function(){return {};}); o._status=r.status; return o; }
    catch(e){ return {ok:false,error:"We couldn't reach our servers just now. Please try again in a moment."}; }
  }
  function renderOtp(step){
    var O=S._otp||(S._otp={ch:'sms',phase:'enter'});
    var err='<div class="ab-err" id="ab-err"></div>';
    if(O.phase==='enter'){
      var sms=O.ch==='sms';
      dock.innerHTML='<label class="ab-fl">'+(sms?'Mobile number (South Africa)':'Email address')+'</label>'+
        '<div class="ab-field"><div class="ab-ip"><input id="ab-otp-to" type="'+(sms?'tel':'email')+'" inputmode="'+(sms?'tel':'email')+'" autocomplete="'+(sms?'tel':'email')+'" placeholder="'+(sms?'e.g. 082 123 4567':'name@example.com')+'"></div><button class="ab-send" id="ab-otp-send" type="button">Send code</button></div>'+err+
        '<div class="ab-hint"><button class="ab-linkbtn" id="ab-otp-alt" type="button">'+(sms?"No South African mobile number? Use email instead":"Use my mobile number instead")+'</button></div>';
      var to=document.getElementById('ab-otp-to'); if(O.raw && O.rawCh===O.ch) to.value=O.raw; to.focus();
      async function send(){
        var v=(to.value||'').trim(); if(!v){document.getElementById('ab-err').textContent=sms?"Please enter your mobile number.":"Please enter your email address."; return;}
        var b=document.getElementById('ab-otp-send'); b.disabled=true; b.textContent='Sending…';
        var out=await postJSON('/api/otp-send',{channel:O.ch,to:v,company:''});
        if(out.ok && out.challenge){ O.raw=v; O.rawCh=O.ch; O.challenge=out.challenge; O.sentTo=out.sentTo; O.sentAt=Date.now(); O.phase='code'; addMe(sms?localPhone(v):v); addBot("I've sent a 6-digit code to "+out.sentTo+". Please enter it below. It expires in 10 minutes."); renderOtp(step); }
        else { b.disabled=false; b.textContent='Send code'; document.getElementById('ab-err').textContent=out.error||"Something went wrong. Please try again."; }
      }
      document.getElementById('ab-otp-send').onclick=send;
      to.addEventListener('keydown',function(e){if(e.key==='Enter')send();});
      document.getElementById('ab-otp-alt').onclick=function(){ O.ch=sms?'email':'sms'; renderOtp(step); };
      return;
    }
    // phase: code
    dock.innerHTML='<label class="ab-fl">6-digit code sent to '+esc(O.sentTo||'')+'</label>'+
      '<div class="ab-field"><div class="ab-ip"><input id="ab-otp-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456"></div><button class="ab-send" id="ab-otp-ok" type="button">Verify</button></div>'+err+
      '<div class="ab-hint"><button class="ab-linkbtn" id="ab-otp-resend" type="button">Resend code</button> · <button class="ab-linkbtn" id="ab-otp-change" type="button">'+(O.ch==='sms'?'Change number':'Change email')+'</button></div>';
    var c=document.getElementById('ab-otp-code'); c.focus();
    async function verify(){
      var code=(c.value||'').replace(/\D/g,''); if(code.length!==6){document.getElementById('ab-err').textContent="Please enter the 6-digit code."; return;}
      var b=document.getElementById('ab-otp-ok'); b.disabled=true; b.textContent='Checking…';
      var out=await postJSON('/api/otp-verify',{challenge:O.challenge,code:code});
      if(out.ok && out.verified){
        S.vtok=out.verified; S.vwho=S.who; S.vch=O.ch;
        var sp=(S.who==='Sponsor');
        S._lock={};
        if(O.ch==='sms'){ var k=sp?'s1_phone':'student_phone'; S[k]=S[k+'2']=localPhone(O.raw); S._lock[k]=S._lock[k+'2']=true; }
        else { var ke=sp?'s1_email':'student_email'; S[ke]=S[ke+'2']=O.raw.trim().toLowerCase(); S._lock[ke]=S._lock[ke+'2']=true; }
        S._otp=null;
        addMe('✓ '+(O.ch==='sms'?'Mobile number':'Email address')+' verified'); advance();
      } else {
        b.disabled=false; b.textContent='Verify';
        document.getElementById('ab-err').textContent=out.error||"That code isn't right. Please try again.";
        if(out.reason==='expired' || out._status===429){ O.phase='enter'; setTimeout(function(){renderOtp(step);},1800); }
      }
    }
    document.getElementById('ab-otp-ok').onclick=verify;
    c.addEventListener('keydown',function(e){if(e.key==='Enter')verify();});
    document.getElementById('ab-otp-change').onclick=function(){ O.phase='enter'; renderOtp(step); };
    document.getElementById('ab-otp-resend').onclick=function(){
      if(Date.now()-(O.sentAt||0)<30000){ document.getElementById('ab-err').textContent="Please wait a few seconds before asking for a new code."; return; }
      O.phase='enter'; renderOtp(step); var s2=document.getElementById('ab-otp-send'); if(s2) s2.click();
    };
  }

  function render(step){
    dock.innerHTML=''; var t=step.t;
    if(t==='intro'||t==='choice'||t==='info'){
      var w=document.createElement('div'); w.className='ab-choices';
      step.o.forEach(function(o){var b=document.createElement('button');b.className='ab-choice';b.type='button';b.textContent=o.l;b.onclick=function(){if(step.k)S[step.k]=o.v;if(t==='choice')addMe(o.l);advance();};w.appendChild(b);});
      dock.appendChild(w);
      return;
    }
    if(t==='wachoice'){
      var wrap=document.createElement('div'); wrap.innerHTML=(step.html||'')+'<div class="ab-choices" id="ab-wc"></div>';
      dock.appendChild(wrap);
      var wc=wrap.querySelector('#ab-wc');
      step.o.forEach(function(o){var b=document.createElement('button');b.className='ab-choice';b.type='button';b.textContent=o.l;b.onclick=function(){S[step.k]=o.v;addMe(o.l);advance();};wc.appendChild(b);});
      return;
    }
    if(t==='form'){
      var html='<div class="ab-form">';
      if(step.title) html+='<div class="ab-form-t">'+esc(step.title)+'</div>';
      step.fields.forEach(function(f){
        var fOpt=(typeof f.opt==='function')?f.opt():f.opt;
        var fLabel=(typeof f.label==='function')?f.label():f.label;
        html+='<label class="ab-fl">'+esc(fLabel)+(fOpt?'':' *')+'</label>';
        if(f.type==='select'){
          html+='<select class="ab-fin" data-k="'+f.k+'"><option value="">Select…</option>'+optsHTML(f.options)+'</select>';
        } else if(f.list){
          html+='<input class="ab-fin" data-k="'+f.k+'" list="'+f.list+'" autocomplete="off" placeholder="'+esc(f.ph||'')+'">';
        } else {
          var itype=f.type==='num'?'number':f.type;
          var pre=f.pfx?'<span class="ab-pfx">'+esc(f.pfx)+'</span>':'';
          html+='<div class="ab-fip '+(f.pfx?'has':'')+'">'+pre+'<input class="ab-fin" data-k="'+f.k+'" type="'+itype+'" placeholder="'+esc(f.ph||'')+'"></div>';
        }
      });
      html+='<div class="ab-err" id="ab-err"></div><button class="ab-send" id="ab-go" type="button" style="width:100%;margin-top:12px">Continue</button></div>';
      dock.innerHTML=html;
      // pre-fill from saved answers (so "Make changes" keeps prior values; confirm fields mirror their base)
      step.fields.forEach(function(f){ var el=dock.querySelector('[data-k="'+f.k+'"]'); if(!el) return; if(S[f.k]!==undefined) el.value=S[f.k]; else if(/2$/.test(f.k) && S[f.k.slice(0,-1)]!==undefined) el.value=S[f.k.slice(0,-1)]; if(S._lock && S._lock[f.k]){ el.readOnly=true; el.classList.add('ab-locked'); el.title='Verified with a code'; } });
      document.getElementById('ab-go').onclick=function(){
        var ok=true, err='';
        step.fields.forEach(function(f){
          var el=dock.querySelector('[data-k="'+f.k+'"]'); var val=(el.value||'').trim();
          el.classList.remove('bad');
          if(!val && !((typeof f.opt==='function')?f.opt():f.opt)){ ok=false; err=err||"Please complete all required fields."; el.classList.add('bad'); return; }
          if(val && f.v){ var e=f.v(val); if(e){ ok=false; err=err||e; el.classList.add('bad'); } }
        });
        if(ok && step.match){
          step.match.forEach(function(m){
            var a=(dock.querySelector('[data-k="'+m[0]+'"]').value||'').trim();
            var b=(dock.querySelector('[data-k="'+m[1]+'"]').value||'').trim();
            if(a!==b){ ok=false; err=err||m[2]||"Entries do not match."; dock.querySelector('[data-k="'+m[1]+'"]').classList.add('bad'); }
          });
        }
        if(!ok){ document.getElementById('ab-err').textContent=err; return; }
        step.fields.forEach(function(f){ var el=dock.querySelector('[data-k="'+f.k+'"]'); var val=(el.value||'').trim(); if(val) S[f.k]=val; });
        addMe(step.done||"✓ Captured"); advance();
      };
      return;
    }
    if(t==='otp'){ renderOtp(step); return; }
    if(t==='review'){
      var applicant=selfFunded()?'Student (self-funded)':(isStudent()?'Student + sponsor':'Sponsor');
      var rows=[['Applicant',applicant],['Existing customer',S.existing_customer||'No'],['Contact channel',S.wa_channel==='WhatsApp'?'WhatsApp':'SMS / email'],['Student',(S.student_first||'')+' '+(S.student_last||'')],['Institution',S.institution],['Course duration',S.course_duration]];
      if(notSelf()) rows.push(['Sponsor',(S.s1_first||'')+' '+(S.s1_last||'')]);
      rows.push(['Gross income/mo',S.gross?'R'+Number(S.gross).toLocaleString('en-ZA'):'—']);
      if(notSelf()) rows.push(['Second income',S.sponsor_two_yes_no||'No']);
      rows.push(['Tuition needed',S.tuition?'R'+Number(S.tuition).toLocaleString('en-ZA'):'—']);
      dock.innerHTML='<div class="ab-review">'+rows.map(function(r){return '<div><span class="k">'+esc(r[0])+'</span><span class="v">'+esc(r[1]||'—')+'</span></div>';}).join('')+'</div><div class="ab-field"><button class="ab-ghost" id="ab-edit" type="button">Make changes</button><button class="ab-send" id="ab-go" type="button" style="flex:1">Looks good, continue</button></div>';
      document.getElementById('ab-go').onclick=function(){ advance(); };
      document.getElementById('ab-edit').onclick=function(){ addMe('Make changes'); i=EDIT_FROM-1; advance(); };
      return;
    }
    if(t==='consent'){
      var t1='I confirm that the information I have provided, including any information about a sponsor, is true and complete to the best of my knowledge. I understand that false information may lead to my application being declined.';
      var t2='I consent to Manati Alternate Student Funding processing my personal information to assess and administer my loan application, and sharing it for this purpose with: Experian (a registered credit bureau), to check my credit record and affordability and to verify my bank account; CODIX, to support Manati\'s credit decision; the Department of Home Affairs, to verify my identity; and my educational institution, to confirm my registration, fees and payments. If my loan is approved, Manati will report the account to registered credit bureaus. I may withdraw my consent at any time, but this may prevent Manati from processing my application. Read our <a href="/terms/" target="_blank">Terms</a> and <a href="/privacy/" target="_blank">Privacy Notice</a>.';
      var spNote = notSelf() ? '<p class="ab-notice-p" style="margin-top:2px"><em>This consent covers your own information only. Manati will contact your sponsor for their own consent before checking their credit record.</em></p>' : '';
      dock.innerHTML='<label class="ab-consent"><input type="checkbox" id="ab-cb1"> <span>'+t1+'</span></label><label class="ab-consent"><input type="checkbox" id="ab-cb2"> <span>'+t2+'</span></label>'+spNote+(_tsKey?'<div id="ab-ts-box" class="ab-tsbox"></div>':'')+'<div class="ab-field"><button class="ab-send" id="ab-go" type="button" style="flex:1">I agree &amp; submit</button></div><div class="ab-err" id="ab-err"></div>';
      document.getElementById('ab-go').onclick=function(){
        if(!document.getElementById('ab-cb1').checked || !document.getElementById('ab-cb2').checked){ document.getElementById('ab-err').textContent="Please tick both boxes to continue."; return; }
        S.consent='Yes'; S.consent_ts=new Date().toISOString();
        submitApp();
      };
      if(_tsKey) mountTurnstile();
      return;
    }
    if(t==='done'){return;}
    // single text/email/tel input
    var pfx=step.pfx?'<span class="pfx">'+esc(step.pfx)+'</span>':'';
    var listAttr=step.list?(' list="'+step.list+'" autocomplete="off"'):'';
    dock.innerHTML='<div class="ab-field"><div class="ab-ip '+(step.pfx?'has-pfx':'')+'">'+pfx+'<input id="ab-inp" type="'+(step.t==='num'?'number':step.t)+'"'+listAttr+' placeholder="'+esc(step.ph||'')+'"></div><button class="ab-send" id="ab-go" type="button">Send</button></div><div class="ab-err" id="ab-err"></div>';
    var inp=document.getElementById('ab-inp'); if(S[step.k]!==undefined) inp.value=S[step.k]; inp.focus();
    function go(){var v=inp.value; if(step.v){var e=step.v(v||''); if(e){document.getElementById('ab-err').textContent=e;return;}} S[step.k]=(v||'').trim(); addMe(v.trim()); advance();}
    document.getElementById('ab-go').onclick=go;
    inp.addEventListener('keydown',function(e){if(e.key==='Enter')go();});
  }

  function runStep(){
    prog(); var step=FLOW[i];
    var msgs=(step.q||[]).map(function(m){return typeof m==='function'?m():m;});
    var k=0;
    (function next(){ if(k>=msgs.length){render(step);return;} addBot(msgs[k]); k++; setTimeout(next,280); })();
  }
  function advance(){
    do { i++; } while(i<FLOW.length && (FLOW[i].sec || (FLOW[i].when && !FLOW[i].when())));
    if(i>=FLOW.length) return;
    runStep();
  }

  function openWidget(){ overlay.hidden=false; document.body.style.overflow='hidden'; if(!started){ started=true; advance(); } }
  function closeWidget(){ overlay.hidden=true; document.body.style.overflow=''; }

  document.getElementById('ab-launch').onclick=openWidget;
  var heroBtn=document.getElementById('ab-open-hero'); if(heroBtn) heroBtn.onclick=openWidget;
  document.getElementById('ab-close').onclick=closeWidget;
  overlay.addEventListener('click',function(e){ if(e.target===overlay) closeWidget(); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape' && !overlay.hidden) closeWidget(); });

  // Auto-open on this dedicated apply page.
  openWidget();
})();
</script>
