---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="About us — Manati" description="Manati Alternate Student Funding provides innovative, individually-assessed study loans for South African students who can't secure traditional funding.">
  <Header />

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">About us</span>
      <h1>Funding high-potential students into the workforce</h1>
      <p>Manati Alternate Student Funding provides innovative funding solutions for the many university and college students who want to study but can't afford it or can't secure financing through traditional lenders.</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap two-col">
      <div>
        <span class="eyebrow">Our vision</span>
        <h2>Catapult students into ultra-employable members of the workforce</h2>
        <p>We provide individually-assessed loans based on a student's past performance and future employment probabilities — not just a credit score. We then help integrate graduates into fitting workplaces and shape them into future mentors who strengthen the generation after them.</p>
        <p>Our goal is to help grow a smart generation of young South Africans, enabling them to become integrated, skilled professionals who make a meaningful contribution to society.</p>
      </div>
      <div class="cards3" style="grid-template-columns:1fr 1fr;gap:18px">
        <div class="card" style="box-shadow:none"><div class="ic">🎯</div><h3 style="font-size:17px">Personalised vetting</h3><p style="font-size:14px;color:var(--muted)">Academic results and course employability, assessed case by case.</p></div>
        <div class="card" style="box-shadow:none"><div class="ic">💸</div><h3 style="font-size:17px">Low interest</h3><p style="font-size:14px;color:var(--muted)">Stable instalments for the loan term and extended payment options.</p></div>
        <div class="card" style="box-shadow:none"><div class="ic">🤝</div><h3 style="font-size:17px">Employment support</h3><p style="font-size:14px;color:var(--muted)">We help graduates find work to ease repayment.</p></div>
        <div class="card" style="box-shadow:none"><div class="ic">🎓</div><h3 style="font-size:17px">Mentorship</h3><p style="font-size:14px;color:var(--muted)">Graduates become mentors to the next generation.</p></div>
      </div>
    </div>
  </section>

  <section class="block bg-soft">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">The gap we fill</span>
        <h2>Built for the "missing middle"</h2>
        <p>Many capable students earn too much to qualify for full government support, yet can't afford fees on their own. Manati exists precisely for that gap — alternative funding for students traditional lenders overlook.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="text-align:center">
      <div class="cta">
        <h2>Ready to invest in your future?</h2>
        <p>The entire application is online — no time off work, no queues.</p>
        <a class="btn" style="background:var(--gold);color:#231f20" href="/how-to-apply">How to apply →</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>
