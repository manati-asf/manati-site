---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="About us — Manati" description="Manati Alternate Student Funding provides innovative, individually-assessed study loans for South African students who can't secure traditional funding.">
  <Header />

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">About us</span>
      <h1>Funding high-potential students into the workforce</h1>
      <p>Manati Alternate Student Funding provides innovative funding solutions for the many university and college students who want to study but can't afford it or can't secure financing through traditional lenders.</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap two-col">
      <div>
        <span class="eyebrow">Our vision</span>
        <h2>The world we're working towards</h2>
        <p>To catapult a generation of capable young South Africans into ultra-employable, confident professionals — and the mentors who will lift the next generation after them.</p>
        <p>We provide individually-assessed loans that look at a student's potential — not just a credit score — so capable young people who fall outside traditional funding can access tertiary education.</p>
      </div>
      <div class="cards3" style="grid-template-columns:1fr 1fr;gap:18px">
        <div class="card" style="box-shadow:none"><div class="ic">🎯</div><h3 style="font-size:17px">Personalised vetting</h3><p style="font-size:14px;color:var(--muted)">Every application assessed individually — including affordability and joint household income.</p></div>
        <div class="card" style="box-shadow:none"><div class="ic">💸</div><h3 style="font-size:17px">Low interest</h3><p style="font-size:14px;color:var(--muted)">Stable instalments for the loan term and extended payment options.</p></div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Our mission</span>
        <h2>What we're doing about it</h2>
        <p>We believe talent is everywhere — but opportunity isn't. Manati provides individually-assessed, low-interest study loans for the students traditional lenders overlook, so that ambition and hard work — not financial circumstance — determine what's possible.</p>
      </div>
      <div class="cards3">
        <div class="card"><div class="ic">🤲</div><h3>Always Helpful</h3><p>We step up, support others, and find solutions.</p></div>
        <div class="card"><div class="ic">🤝</div><h3>Always Respectful</h3><p>We treat each other with dignity, fairness, and consideration.</p></div>
        <div class="card"><div class="ic">🛡️</div><h3>Always with Integrity</h3><p>We do the right thing, even when no one is watching.</p></div>
      </div>
    </div>
  </section>

  <section class="block bg-soft">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">The gap we fill</span>
        <h2>Built for the "missing middle"</h2>
        <p>Many capable students earn too much to qualify for full government support, yet can't afford fees on their own. Manati exists precisely for that gap — alternative funding for students traditional lenders overlook.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="text-align:center">
      <div class="cta">
        <h2>Ready to invest in your future?</h2>
        <p>The entire application is online — no time off work, no queues.</p>
        <a class="btn" style="background:var(--gold);color:#231f20" href="/how-to-apply">How to apply →</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>
