---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="For institutions — Manati" description="Partner with Manati to grow your student base. Alternative funding that helps qualifying students enrol, complete and find work.">
  <Header />

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">For institutions</span>
      <h1>Partner with us to grow your student base</h1>
      <p>The demand for student loans is high, but securing funding is costly and difficult for most students. With fresh thinking and key partnerships, we offer alternative funding that contributes to a brighter economic future for all.</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">How it works</span>
        <h2>A simple partnership</h2>
      </div>
      <div class="steps">
        <div class="step">
          <h4>Identify students</h4>
          <p>Universities and colleges identify students who qualify to study but are unable to fund their studies.</p>
        </div>
        <div class="step">
          <h4>They apply</h4>
          <p>Prospective students (and their sponsors) complete the Manati online application.</p>
        </div>
        <div class="step">
          <h4>We structure the loan</h4>
          <p>We assess eligibility and structure reasonable loans on a case-by-case basis, then support repayment.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block bg-soft">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Why partner with Manati</span>
        <h2>More students, more graduates, more revenue</h2>
      </div>
      <div class="cards3">
        <div class="card">
          <div class="ic">📈</div>
          <h3>More students</h3>
          <p style="color:var(--muted)">By commercially partnering with you, we offer low interest rates and extended payment terms that enable students to enrol who would otherwise be unable to source funding.</p>
        </div>
        <div class="card">
          <div class="ic">🎓</div>
          <h3>More graduates</h3>
          <p style="color:var(--muted)">Partner institutions are more likely to see students complete their studies and find employment, owing to the right students being selected and lower financial pressure during studies.</p>
        </div>
        <div class="card">
          <div class="ic">💸</div>
          <h3>Increased revenue</h3>
          <p style="color:var(--muted)">We manage the risk of defaulting repayments by assisting students to find work after graduating — improving commercial returns and revenue for institutions.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="text-align:center">
      <div class="cta">
        <h2>Let's grow together</h2>
        <p>Talk to us about a partnership that helps more of your students enrol and succeed.</p>
        <a class="btn" style="background:var(--gold);color:#231f20" href="/contact">Become a partner →</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>
