---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const posts = (await getCollection('insights')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const thumbs = ['', 'alt', 'alt2'];
---
<Base>
<Header />

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow" style="color:var(--gold)">Alternate Student Funding</span>
      <h1>Unlocking student loans to grow a <span class="accent">smart future</span>.</h1>
      <p class="lede">Manati provides greater access, achievement and affordability in tertiary education — low-interest study loans for the many capable students who can&apos;t secure traditional funding.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#apply">Apply for funding →</a>
        <a class="btn btn-ghost" href="#how">How it works</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><div class="n">Low</div><div class="l">interest rates</div></div>
        <div class="stat"><div class="n">Flexible</div><div class="l">repayment options</div></div>
        <div class="stat"><div class="n">100%</div><div class="l">online application</div></div>
      </div>
    </div>

    <div class="hero-card" id="apply">
      <h3>Estimate your repayment</h3>
      <div class="sub">Slide to explore. Indicative only — your actual rate and terms are set on assessment.</div>
      <div class="slider-group">
        <div class="slider-head"><label for="amt">Loan amount</label><span class="calc-val" id="amtVal">R 60 000</span></div>
        <input type="range" id="amt" min="10000" max="200000" step="5000" value="60000" aria-label="Loan amount" />
      </div>
      <div class="slider-group">
        <div class="slider-head"><label for="term">Repayment term</label><span class="calc-val" id="termVal">48 months</span></div>
        <input type="range" id="term" min="12" max="60" step="6" value="48" aria-label="Repayment term" />
      </div>
      <div class="calc-total"><span>Est. monthly repayment<br /><small style="color:#b9b3a6;font-weight:400">on a standard repayment plan</small></span><span class="big" id="monthly">R 1 655</span></div>
      <a class="btn btn-primary" href="/how-to-apply" style="width:100%;justify-content:center;margin-top:20px">Start your application</a>
      <div class="note">This estimate is for guidance only and is not a quote or an offer of credit. It assumes an illustrative rate of 14.5% p.a.; your actual rate, fees and repayment are confirmed on individual assessment and approval, in line with the National Credit Act. Tip: apply with joint household income to improve your chances of approval.</div>
    </div>
  </div>
</section>

<section class="partners">
  <div class="wrap">
    <div class="lbl">Trusted by leading education institutions</div>
    <div class="ticker"><div class="ticker-track"><img src="/assets/partners/rosebank-college.png" alt="Rosebank College" loading="lazy" /><img src="/assets/partners/vega-school.png" alt="Vega School" loading="lazy" /><img src="/assets/partners/stadio.png" alt="Stadio" loading="lazy" /><img src="/assets/partners/afda.png" alt="AFDA" loading="lazy" /><img src="/assets/partners/pearson.png" alt="Pearson" loading="lazy" /><img src="/assets/partners/ctu-training-solutions.png" alt="CTU Training Solutions" loading="lazy" /><img src="/assets/partners/sae-institute.png" alt="SAE Institute" loading="lazy" /><img src="/assets/partners/hyperiondev.png" alt="HyperionDev" loading="lazy" /><img src="/assets/partners/elizabeth-galloway.png" alt="Elizabeth Galloway" loading="lazy" /><img src="/assets/partners/oakfields-college.png" alt="Oakfields College" loading="lazy" /><img src="/assets/partners/swiss-hotel-school.png" alt="Swiss Hotel School" loading="lazy" /><img src="/assets/partners/act.png" alt="ACT" loading="lazy" /><img src="/assets/partners/aie.png" alt="AIE" loading="lazy" /><img src="/assets/partners/1000-hills.png" alt="1000 Hills" loading="lazy" /><img src="/assets/partners/rise-academy.png" alt="Rise Academy" loading="lazy" /><img src="/assets/partners/design-academy-of-fashion.png" alt="Design Academy of Fashion" loading="lazy" /><img src="/assets/partners/rosebank-college.png" alt="Rosebank College" loading="lazy" /><img src="/assets/partners/vega-school.png" alt="Vega School" loading="lazy" /><img src="/assets/partners/stadio.png" alt="Stadio" loading="lazy" /><img src="/assets/partners/afda.png" alt="AFDA" loading="lazy" /><img src="/assets/partners/pearson.png" alt="Pearson" loading="lazy" /><img src="/assets/partners/ctu-training-solutions.png" alt="CTU Training Solutions" loading="lazy" /><img src="/assets/partners/sae-institute.png" alt="SAE Institute" loading="lazy" /><img src="/assets/partners/hyperiondev.png" alt="HyperionDev" loading="lazy" /><img src="/assets/partners/elizabeth-galloway.png" alt="Elizabeth Galloway" loading="lazy" /><img src="/assets/partners/oakfields-college.png" alt="Oakfields College" loading="lazy" /><img src="/assets/partners/swiss-hotel-school.png" alt="Swiss Hotel School" loading="lazy" /><img src="/assets/partners/act.png" alt="ACT" loading="lazy" /><img src="/assets/partners/aie.png" alt="AIE" loading="lazy" /><img src="/assets/partners/1000-hills.png" alt="1000 Hills" loading="lazy" /><img src="/assets/partners/rise-academy.png" alt="Rise Academy" loading="lazy" /><img src="/assets/partners/design-academy-of-fashion.png" alt="Design Academy of Fashion" loading="lazy" /></div></div>
  </div>
</section>

<section class="block" id="benefits">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">3 key benefits</span>
      <h2>How Manati benefits you</h2>
      <p>Funding designed around students, the institutions that teach them, and the funders who make it possible.</p>
    </div>
    <div class="cards3">
      <div class="card">
        <div class="ic">🎓</div>
        <h3>For students</h3>
        <p>Study now, with terms built around your reality.</p>
        <ul>
          <li>Flexible repayment options structured to suit you</li>
          <li>Low interest rates</li>
          <li>Fully online — no branches or queues</li>
        </ul>
      </div>
      <div class="card">
        <div class="ic">🏛️</div>
        <h3>For institutions</h3>
        <p>Grow enrolment and completion with funded students.</p>
        <ul>
          <li>Enrol qualifying students who lack funding</li>
          <li>Higher enrolment and completion rates</li>
          <li>Increased, de-risked revenue</li>
        </ul>
      </div>
      <div class="card">
        <div class="ic">🤝</div>
        <h3>For funders</h3>
        <p>Back high-potential students with managed risk.</p>
        <ul>
          <li>Individually-assessed, risk-scored loans</li>
          <li>Repayment structured over an extended term</li>
          <li>Measurable social and economic impact</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="block" style="padding-top:6px">
  <div class="wrap">
    <div class="nps-band">
      <div class="nps-gauge">
        <svg viewBox="0 0 320 200" role="img" aria-label="Net Promoter Score gauge showing 76 out of 100, in the world-class range">
          <g fill="none" stroke-width="20">
            <path d="M42,155 A118,118 0 0 1 160,37" stroke="#ef4136"/>
            <path d="M160,37 A118,118 0 0 1 213.6,49.9" stroke="#e0a030"/>
            <path d="M213.6,49.9 A118,118 0 0 1 265.1,101.4" stroke="#8fd0a6"/>
            <path d="M265.1,101.4 A118,118 0 0 1 278,155" stroke="#53dd9d"/>
          </g>
          <line x1="160" y1="155" x2="249.3" y2="119.7" stroke="#fff" stroke-width="4" stroke-linecap="round"/>
          <circle cx="160" cy="155" r="7" fill="#dec323"/>
          <text x="160" y="140" text-anchor="middle" font-family="'Varela Round',Verdana,sans-serif" font-size="42" font-weight="bold" fill="#dec323">76</text>
          <text x="34" y="178" text-anchor="middle" font-size="11" fill="#cfc9bd">−100</text>
          <text x="160" y="30" text-anchor="middle" font-size="11" fill="#cfc9bd">0</text>
          <text x="286" y="178" text-anchor="middle" font-size="11" fill="#cfc9bd">+100</text>
        </svg>
      </div>
      <div class="nps-copy">
        <div class="nps-title">Our Net Promoter Score is 76</div>
        <div class="nps-sub">A score above 70 is widely regarded as <strong>world-class</strong> — and well above the banking-sector norm. It's the clearest measure of how our students feel about us.</div>
        <details class="nps-more">
          <summary>How the Net Promoter Score works</summary>
          <div class="nps-more-body">
            <p>NPS runs from −100 to +100. It comes from a single question — "How likely are you to recommend us?" (0–10) — where the percentage of <strong>Promoters</strong> (9–10) minus the percentage of <strong>Detractors</strong> (0–6) gives the score.</p>
            <p>As a rule of thumb: above <strong>0</strong> is good, above <strong>30</strong> is great, above <strong>50</strong> is excellent, and above <strong>70</strong> is considered world-class. Many benchmarks put the banking-sector average near 30 — so our 76 sits firmly in the top tier.</p>
          </div>
        </details>
      </div>
    </div>
  </div>
</section>

<section class="block bg-soft" id="how">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Simple &amp; online</span>
      <h2>How it works</h2>
      <p>A personalised, individually-assessed process that looks at your circumstances and affordability — not just a credit score.</p>
    </div>
    <div class="steps">
      <div class="step">
        <h4>Apply online</h4>
        <p>Complete the full application from anywhere — add joint household income to strengthen your chances.</p>
      </div>
      <div class="step">
        <h4>We assess</h4>
        <p>We assess each application individually — including affordability and joint household income — to structure a reasonable loan.</p>
      </div>
      <div class="step">
        <h4>Study &amp; succeed</h4>
        <p>Repayment is structured to suit your circumstances, so you can focus on your studies and repay with confidence.</p>
      </div>
    </div>
  </div>
</section>

<section class="block" id="institutions">
  <div class="wrap" style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center">
    <div>
      <span class="eyebrow">For institutions</span>
      <h2 style="font-size:32px;color:var(--navy);margin:10px 0 14px">Partner with us to grow your student base</h2>
      <p style="color:var(--muted);font-size:16.5px;margin-bottom:18px">The demand for student loans is high, but securing funding is hard for most students. We partner with universities and colleges to offer alternative funding with low interest and extended terms — so more qualifying students can enrol and complete their studies.</p>
      <a class="btn btn-dark" href="/for-institutions">Become a partner</a>
      <img class="feature-img" style="margin-top:24px;max-height:280px" src="/assets/img/institutions-campus.jpg" alt="Lecture hall on a South African campus" loading="lazy" />
    </div>
    <div class="cards3" style="grid-template-columns:1fr 1fr;gap:18px">
      <div class="card" style="box-shadow:none"><div class="ic">📈</div><h3 style="font-size:17px">More students</h3><p style="font-size:14px">Enable enrolment that funding gaps would otherwise block.</p></div>
      <div class="card" style="box-shadow:none"><div class="ic">🎯</div><h3 style="font-size:17px">More graduates</h3><p style="font-size:14px">Right students selected; less financial pressure during study.</p></div>
      <div class="card" style="box-shadow:none"><div class="ic">💸</div><h3 style="font-size:17px">More revenue</h3><p style="font-size:14px">Managed repayment risk improves commercial returns.</p></div>
      <div class="card" style="box-shadow:none"><div class="ic">🧭</div><h3 style="font-size:17px">Smart model</h3><p style="font-size:14px">Personalised vetting and risk scoring built in.</p></div>
    </div>
  </div>
</section>

<section class="block bg-soft" id="articles">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Insights</span>
      <h2>Guidance for students &amp; families</h2>
      <p>Practical reads on funding, studying, and planning ahead.</p>
    </div>
    <div class="cards3">
      {posts.map((p, i) => (
        <a class="card art" href={`/insights/${p.slug}/`}>
          <div class={`thumb ${thumbs[i % 3]}`}></div>
          <div class="body"><span class="tag">{p.data.tag}</span><h3>{p.data.title}</h3><p>{p.data.summary}</p></div>
        </a>
      ))}
    </div>
    <div style="text-align:center;margin-top:36px">
      <a class="btn btn-dark" href="/insights">Read all articles →</a>
    </div>
  </div>
</section>

<section class="block" id="contact">
  <div class="wrap">
    <div class="cta">
      <h2>Ready to fund your future?</h2>
      <p>The entire application is online — no time off work, no queues.</p>
      <a class="btn" style="background:var(--gold);color:#231f20" href="/how-to-apply">Apply now →</a>
    </div>
  </div>
</section>

<Footer />

<script is:inline>
  (function () {
    var RATE = 0.145; // indicative annual interest rate (placeholder)
    var amt = document.getElementById('amt'), term = document.getElementById('term');
    var amtVal = document.getElementById('amtVal'), termVal = document.getElementById('termVal'), monthly = document.getElementById('monthly');
    function fmt(n) { return 'R ' + Math.round(n).toLocaleString('en-ZA').replace(/,/g, ' '); }
    function calc() {
      var P = +amt.value, n = +term.value, r = RATE / 12;
      var M = r === 0 ? P / n : P * r / (1 - Math.pow(1 + r, -n));
      amtVal.textContent = fmt(P);
      termVal.textContent = n + ' months';
      monthly.textContent = fmt(M);
    }
    amt.addEventListener('input', calc);
    term.addEventListener('input', calc);
    calc();
  })();
</script>
</Base>
