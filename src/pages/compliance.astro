---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const certificates = [
  { period: '2026 / 2027', issued: '1 August 2026', expires: '31 July 2027', file: '/assets/certificates/manati-ncr-certificate-2026-2027.pdf', current: true },
  { period: '2025 / 2026', issued: '1 August 2025', expires: '31 July 2026', file: '/assets/certificates/manati-ncr-certificate-2025-2026.pdf' },
  { period: '2024 / 2025', issued: '1 August 2024', expires: '31 July 2025', file: '/assets/certificates/manati-ncr-certificate-2024-2025.pdf' },
  { period: '2023 / 2024', issued: '1 August 2023', expires: '31 July 2024', file: '/assets/certificates/manati-ncr-certificate-2023-2024.pdf' },
  { period: '2022 / 2023', issued: '1 August 2022', expires: '31 July 2023', file: '/assets/certificates/manati-ncr-certificate-2022-2023.pdf' },
  { period: '2021 / 2022', issued: '1 August 2021', expires: '31 July 2022', file: '/assets/certificates/manati-ncr-certificate-2021-2022.pdf' },
  { period: '2020 / 2021', issued: '1 August 2020', expires: '31 July 2021', file: '/assets/certificates/manati-ncr-certificate-2020-2021.pdf' },
  { period: '2019 / 2020', issued: '26 August 2019', expires: '31 July 2020', file: '/assets/certificates/manati-ncr-certificate-2019-2020.pdf' },
];
const current = certificates[0];
const history = certificates.slice(1);
---
<Base title="Compliance & accreditation — Manati" description="Manati Alternate Student Funding is a registered credit provider (NCRCP8052) under the National Credit Act. View our NCR registration certificates from 2019 to date.">
  <Header />

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Compliance</span>
      <h1>Registration &amp; accreditation</h1>
      <p>Manati Alternate Student Funding is a registered credit provider under the National Credit Act. Below is our current National Credit Regulator (NCR) certificate, together with every certificate since 2019, an unbroken record of our compliance.</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width:900px">
      <div class="info-card" style="margin-bottom:28px">
        <p style="margin:0 0 6px"><strong>Manati Alternate Student Funding</strong></p>
        <p style="margin:0;color:var(--muted)">Registration number: 2015/235473/07</p>
        <p style="margin:0;color:var(--muted)">NCR registration: <strong>NCRCP8052</strong></p>
      </div>

      <span class="eyebrow">Current certificate</span>
      <h2 style="color:var(--navy);font-size:22px;margin:6px 0 14px">Valid now</h2>
      <a class="cert cert-current" href={current.file} target="_blank" rel="noopener">
        <div class="cert-body">
          <span class="cert-badge">Current</span>
          <div class="cert-period">{current.period}</div>
          <div class="cert-dates">Valid {current.issued} to {current.expires}</div>
        </div>
        <div class="cert-cta">View certificate (PDF) →</div>
      </a>

      <span class="eyebrow" style="display:block;margin-top:36px">Compliance history</span>
      <h2 style="color:var(--navy);font-size:22px;margin:6px 0 14px">Previous certificates</h2>
      <div class="cert-grid">
        {history.map((c) => (
          <a class="cert" href={c.file} target="_blank" rel="noopener">
            <div class="cert-body">
              <div class="cert-period">{c.period}</div>
              <div class="cert-dates">Valid {c.issued} to {c.expires}</div>
            </div>
            <div class="cert-cta">View PDF →</div>
          </a>
        ))}
      </div>

      <p style="color:var(--muted);font-size:14px;margin-top:28px">Certificates are issued annually by the National Credit Regulator. For any queries about our registration, contact <a href="mailto:info@manati.co.za" style="color:var(--teal-d);font-weight:600">info@manati.co.za</a>.</p>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .cert {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    text-decoration: none;
    border: 1px solid var(--line, #e6ebf0);
    border-radius: var(--radius, 16px);
    padding: 18px 22px;
    background: #fff;
    transition: border-color .15s ease, transform .15s ease;
  }
  .cert:hover { border-color: var(--gold, #dec323); transform: translateY(-1px); }
  .cert-current { border-color: var(--gold, #dec323); border-width: 2px; background: var(--bg-soft, #f5f8fa); }
  .cert-period { font-size: 20px; font-weight: 700; color: var(--navy, #231f20); }
  .cert-dates { font-size: 14px; color: var(--muted, #5c6b7a); margin-top: 2px; }
  .cert-cta { font-size: 14px; font-weight: 600; color: var(--teal-d); white-space: nowrap; }
  .cert-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    color: var(--navy, #231f20);
    background: var(--gold, #dec323);
    padding: 2px 10px;
    border-radius: 999px;
    margin-bottom: 8px;
  }
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  @media (max-width: 640px) {
    .cert-grid { grid-template-columns: 1fr; }
    .cert { flex-direction: column; align-items: flex-start; }
  }
</style>
